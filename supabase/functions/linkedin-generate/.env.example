# Secrets for the linkedin-generate Edge Function.
# NEVER commit real keys. Set them on Supabase with:
#   supabase secrets set GEMINI_API_KEY=your-key
# (or copy this file to .env and run: supabase secrets set --env-file supabase/functions/linkedin-generate/.env)

# Which AI writes the posts: gemini (default) | openai | anthropic
LLM_PROVIDER=gemini

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model name (default gemini-3.6-flash). If it is busy or retired,
# the function falls back to GEMINI_FALLBACK_MODELS in order.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# OpenAI (ChatGPT) — get a key at https://platform.openai.com/api-keys
# (needs billing credit on the OpenAI account)
# OPENAI_API_KEY=
# Optional: model name (default gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# Anthropic Claude — optional third option
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
