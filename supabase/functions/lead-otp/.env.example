# Secrets for the lead-otp Edge Function.
# NEVER commit real values. Set them in the Supabase Dashboard
# (Edge Functions -> Secrets) or with:
#   supabase secrets set --env-file supabase/functions/lead-otp/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# --- CAPTCHA (Cloudflare Turnstile) — required -------------------------
# Testing: Cloudflare's always-pass test secret below works with the
# test site key that the website uses when PUBLIC_TURNSTILE_SITE_KEY is
# not set. Before go-live, replace it with the real secret key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Email: Resend (tried first) ---------------------------------------
# API key from https://resend.com/api-keys (permission: "Sending access").
RESEND_API_KEY=
# Until utkarshminds.com is verified in Resend, leave RESEND_FROM empty:
# Resend's test sender then only delivers to the Resend account's own
# email address. After verification:
# RESEND_FROM=Utkarsh Minds <noreply@utkarshminds.com>
RESEND_FROM=

# --- Email: cPanel mailbox (automatic backup) --------------------------
# Used whenever Resend fails, e.g. after its free 100 emails/day.
# Port must be 465 (SSL) — Supabase blocks 25 and 587.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=Utkarsh Minds <noreply@notify.utkarshminds.com>
SMTP_FROM=

# --- Optional ----------------------------------------------------------
# Order to try providers in. To test the cPanel backup on its own, set
# EMAIL_PROVIDERS=smtp temporarily.
# EMAIL_PROVIDERS=resend,smtp
# Where replies to the code email should go (e.g. an office inbox).
# EMAIL_REPLY_TO=
# Most codes the whole site may send per 24 hours (protects the domain's
# reputation if someone abuses the form). Default 300.
# OTP_DAILY_LIMIT=300
# Websites allowed to call this function (comma-separated, no trailing /).
# ALLOWED_ORIGINS=https://utkarshminds.com,https://www.utkarshminds.com,http://localhost:4321
