# Copy to .env and adjust. Only PUBLIC_* values reach the browser —
# never put API keys here.

# AI provider for the LinkedIn Post Generator and the Resume Generator:
#   template - rule-based drafts/wording, no AI (default; works without any setup)
#   supabase - real AI via the Supabase Edge Functions `linkedin-generate`
#              and `resume-ai` (deploy them and set GEMINI_API_KEY — or
#              OPENAI_API_KEY with LLM_PROVIDER=openai — as Supabase secrets
#              first; see supabase/functions/linkedin-generate/.env.example)
PUBLIC_AI_PROVIDER=template

# Older name, still honoured by both features:
# PUBLIC_LINKEDIN_AI_PROVIDER=supabase

# Cloudflare Turnstile site key for the enquiry forms (public, not a
# secret). Leave unset for local testing: Cloudflare's always-pass test
# key is used. Must be the pair of the TURNSTILE_SECRET_KEY set in
# Supabase — see docs/otp-and-leads-setup.md (Part F).
# PUBLIC_TURNSTILE_SITE_KEY=
