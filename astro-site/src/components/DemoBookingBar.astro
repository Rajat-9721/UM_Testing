---
/**
 * Thin announcement bar above the main Header — "Book a Free Demo
 * Lecture". Deliberately a plain (non-sticky) block placed before the
 * already-sticky Header in the DOM: it scrolls away normally once the
 * user scrolls past it, and the Header then sticks to the very top on
 * its own, exactly as it already does. No scroll-listener JS needed.
 *
 * The form is the shared LeadCaptureDialog: the visitor confirms their
 * email with a 6-digit code, then the lead (with the optional education
 * status) is saved as "Demo lecture request" by the lead-otp Edge
 * Function. WhatsApp stays available as a no-form alternative.
 */
import LeadCaptureDialog from './LeadCaptureDialog.astro';

const PROGRAM_NAME = 'Professional Certification in AI';
const WHATSAPP_NUMBER = '919619997797';
const WHATSAPP_MESSAGE = "Hi, I'd like to book a free demo lecture for the AI program.";
---

<div class="demo-bar">
  <button type="button" class="demo-bar-trigger" id="demo-bar-trigger">
    Book a Free Demo Lecture
    <span class="demo-bar-arrow" aria-hidden="true">&rarr;</span>
  </button>
</div>

<LeadCaptureDialog
  id="demo"
  source="demo_lecture_request"
  program={PROGRAM_NAME}
  trigger="#demo-bar-trigger"
  title="Book a Free Demo Lecture"
  subtitle="Share your details and confirm your email — our team will then schedule a free demo session for the AI program."
  submitLabel="Send code"
  verifyLabel="Verify & Book"
  successTitle="Demo request received"
  successMessage="Thank you! Our team will reach out shortly to schedule your free demo lecture."
  askEducation
>
  <Fragment slot="after-form">
    <div class="demo-divider" role="separator"><span>or</span></div>
    <a
      class="demo-whatsapp-link"
      href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`}
      target="_blank"
      rel="noopener"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.2h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.15c-.24.68-1.4 1.3-1.93 1.37-.5.08-1.13.11-1.82-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.8-4.17-4.94-4.36-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.65.5.24.58.82 2 .89 2.15.07.15.12.32.02.51-.09.19-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.22 1.37.28.14.44.12.6-.07.17-.19.71-.83.9-1.11.19-.28.38-.24.63-.14.26.09 1.65.78 1.93.92.28.14.47.21.54.33.07.12.07.68-.17 1.36Z"
        />
      </svg>
      Chat on WhatsApp instead
    </a>
  </Fragment>
</LeadCaptureDialog>

<style>
  .demo-bar {
    /* Deliberately lighter than --color-accent (that token is the
       saturated brass used for buttons) — this is a thin strip above
       the header, not a CTA button, so it stays soft/pastel. */
    background: #f6e8c8;
  }

  .demo-bar-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary-dark);
    background: none;
    border: none;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .demo-bar-trigger:hover,
  .demo-bar-trigger:focus-visible {
    background: #efd9a8;
  }

  .demo-bar-arrow {
    transition: transform 0.2s ease;
  }

  .demo-bar-trigger:hover .demo-bar-arrow {
    transform: translateX(3px);
  }

  .demo-divider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-6) 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .demo-divider::before,
  .demo-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .demo-whatsapp-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid #25d366;
    border-radius: var(--radius-md);
    color: #128c4a;
    font-weight: 600;
    font-size: var(--text-sm);
    transition: var(--transition-fast);
  }

  .demo-whatsapp-link:hover {
    background: #25d366;
    color: #fff;
  }

  @media (max-width: 480px) {
    .demo-bar-trigger {
      font-size: var(--text-xs);
      padding: var(--space-2) var(--space-3);
    }
  }
</style>

