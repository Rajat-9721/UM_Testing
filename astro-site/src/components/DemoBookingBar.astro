---
/**
 * Thin announcement bar above the main Header — "Book a Free Demo
 * Lecture". Deliberately a plain (non-sticky) block placed before the
 * already-sticky Header in the DOM: it scrolls away normally once the
 * user scrolls past it, and the Header then sticks to the very top on
 * its own, exactly as it already does. No scroll-listener JS needed.
 *
 * Lead capture reuses the same lightweight pattern as the "Notify Me"
 * CTA (StickyProgramPanel.astro) — a dynamically-imported Supabase
 * client writing into the existing marketing_leads table — rather than
 * introducing a second approach. `education_status` is a new nullable
 * column on that table (see marketing_leads.sql).
 */
import Button from './Button.astro';

const PROGRAM_NAME = 'Professional Certification in AI';
const WHATSAPP_NUMBER = '919619997797';
const WHATSAPP_MESSAGE = "Hi, I'd like to book a free demo lecture for the AI program.";
---

<div class="demo-bar">
  <button type="button" class="demo-bar-trigger" id="demo-bar-trigger">
    Book a Free Demo Lecture
    <span class="demo-bar-arrow" aria-hidden="true">&rarr;</span>
  </button>
</div>

<dialog id="demo-dialog" class="demo-dialog">
  <form id="demo-form" class="demo-form" novalidate>
    <button type="button" class="demo-close" id="demo-close" aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
    </button>

    <div data-demo-form-body>
      <h3 class="demo-title">Book a Free Demo Lecture</h3>
      <p class="demo-subtitle">
        Share your details and our team will schedule a free demo session for the AI program.
      </p>

      <div class="demo-field">
        <label for="demo-name">Full Name</label>
        <input id="demo-name" name="name" type="text" autocomplete="name" required />
        <span class="demo-error" data-error-for="name"></span>
      </div>

      <div class="demo-field">
        <label for="demo-email">Email</label>
        <input id="demo-email" name="email" type="email" autocomplete="email" required />
        <span class="demo-error" data-error-for="email"></span>
      </div>

      <div class="demo-field">
        <label for="demo-mobile">Mobile Number</label>
        <input id="demo-mobile" name="mobile" type="tel" inputmode="numeric" autocomplete="tel" placeholder="10-digit mobile number" required />
        <span class="demo-error" data-error-for="mobile"></span>
      </div>

      <div class="demo-field">
        <label for="demo-education">Current Education / Status</label>
        <select id="demo-education" name="education">
          <option value="">Select an option</option>
          <option value="Currently pursuing graduation">Currently pursuing graduation</option>
          <option value="Diploma holder">Diploma holder</option>
          <option value="Graduate">Graduate</option>
          <option value="Postgraduate / PGDM">Postgraduate / PGDM</option>
          <option value="PhD scholar">PhD scholar</option>
          <option value="Working professional">Working professional</option>
        </select>
      </div>

      <p class="demo-submit-error" data-submit-error hidden></p>

      <div class="demo-actions">
        <button type="button" class="demo-cancel" data-demo-cancel>Cancel</button>
        <Button type="submit" variant="primary" class="demo-submit-btn" id="demo-submit-btn">
          Book Demo
        </Button>
      </div>

      <div class="demo-divider" role="separator"><span>or</span></div>

      <a
        class="demo-whatsapp-link"
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`}
        target="_blank"
        rel="noopener"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.2h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.15c-.24.68-1.4 1.3-1.93 1.37-.5.08-1.13.11-1.82-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.8-4.17-4.94-4.36-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.65.5.24.58.82 2 .89 2.15.07.15.12.32.02.51-.09.19-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.22 1.37.28.14.44.12.6-.07.17-.19.71-.83.9-1.11.19-.28.38-.24.63-.14.26.09 1.65.78 1.93.92.28.14.47.21.54.33.07.12.07.68-.17 1.36Z"
          />
        </svg>
        Chat on WhatsApp instead
      </a>
    </div>

    <div class="demo-success" data-demo-success hidden>
      <p>Thank you! Our team will reach out shortly to schedule your free demo lecture.</p>
      <button type="button" class="demo-cancel" data-demo-close-success>Close</button>
    </div>
  </form>
</dialog>

<style>
  .demo-bar {
    /* Deliberately lighter than --color-accent (that token is the
       saturated brass used for buttons) — this is a thin strip above
       the header, not a CTA button, so it stays soft/pastel. */
    background: #f6e8c8;
  }

  .demo-bar-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary-dark);
    background: none;
    border: none;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .demo-bar-trigger:hover,
  .demo-bar-trigger:focus-visible {
    background: #efd9a8;
  }

  .demo-bar-arrow {
    transition: transform 0.2s ease;
  }

  .demo-bar-trigger:hover .demo-bar-arrow {
    transform: translateX(3px);
  }

  /* Dialog — reuses the same card border/shadow/radius language as the
     Notify Me modal rather than inventing new modal chrome. */
  .demo-dialog {
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    width: min(420px, 92vw);
    max-height: min(680px, 90vh);
    overflow: hidden auto;
  }

  .demo-dialog::backdrop {
    background: rgba(22, 34, 28, 0.55);
  }

  .demo-form {
    position: relative;
    padding: var(--space-8) var(--space-6) var(--space-6);
  }

  .demo-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .demo-close:hover {
    background: var(--color-bg-subtle);
    color: var(--color-primary);
  }

  .demo-title {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-bottom: var(--space-2);
    padding-right: var(--space-8);
  }

  .demo-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .demo-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .demo-field label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .demo-field input,
  .demo-field select {
    font-family: inherit;
    font-size: var(--text-base);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .demo-field input:focus-visible,
  .demo-field select:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .demo-field input[aria-invalid='true'] {
    border-color: var(--color-danger);
  }

  .demo-error {
    font-size: var(--text-xs);
    color: var(--color-danger);
    min-height: 1em;
  }

  .demo-submit-error {
    font-size: var(--text-sm);
    color: var(--color-danger);
    margin-bottom: var(--space-4);
  }

  .demo-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .demo-cancel {
    font-family: inherit;
    font-size: var(--text-base);
    font-weight: 600;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: var(--space-3) var(--space-4);
  }

  .demo-cancel:hover {
    color: var(--color-primary);
  }

  .demo-form :global(.demo-submit-btn) {
    min-width: 140px;
  }

  .demo-form :global(.demo-submit-btn[disabled]) {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }

  .demo-divider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-6) 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .demo-divider::before,
  .demo-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .demo-whatsapp-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid #25d366;
    border-radius: var(--radius-md);
    color: #128c4a;
    font-weight: 600;
    font-size: var(--text-sm);
    transition: var(--transition-fast);
  }

  .demo-whatsapp-link:hover {
    background: #25d366;
    color: #fff;
  }

  .demo-success {
    padding: var(--space-8) var(--space-6);
    text-align: center;
  }

  .demo-success p {
    color: var(--color-text);
    font-size: var(--text-lg);
    margin-bottom: var(--space-6);
  }

  @media (max-width: 480px) {
    .demo-form {
      padding: var(--space-6) var(--space-5) var(--space-5);
    }

    .demo-bar-trigger {
      font-size: var(--text-xs);
      padding: var(--space-2) var(--space-3);
    }
  }
</style>

<script define:vars={{ PROGRAM_NAME }}>
  const SUPABASE_URL = 'https://ohytjcwcmzalftmsdvbq.supabase.co';
  const SUPABASE_ANON_KEY = 'sb_publishable_ApiQJQ2W-sfMo7i3jl_NSw_0eWMvVmF';
  const LEAD_SOURCE = 'demo_lecture_request';

  let supabaseClientPromise = null;
  function getSupabaseClient() {
    if (!supabaseClientPromise) {
      supabaseClientPromise = import('https://esm.sh/@supabase/supabase-js@2').then(
        ({ createClient }) => createClient(SUPABASE_URL, SUPABASE_ANON_KEY)
      );
    }
    return supabaseClientPromise;
  }

  const trigger = document.getElementById('demo-bar-trigger');
  const dialog = document.getElementById('demo-dialog');
  const form = document.getElementById('demo-form');
  const closeBtn = document.getElementById('demo-close');
  const submitBtn = document.getElementById('demo-submit-btn');
  const formBody = form?.querySelector('[data-demo-form-body]');
  const successPanel = form?.querySelector('[data-demo-success]');
  const submitError = form?.querySelector('[data-submit-error]');

  if (trigger && dialog && form && submitBtn && formBody && successPanel && submitError) {
    const nameInput = form.elements.namedItem('name');
    const emailInput = form.elements.namedItem('email');
    const mobileInput = form.elements.namedItem('mobile');
    const educationInput = form.elements.namedItem('education');
    let isSubmitting = false;

    function fieldError(field) {
      return form.querySelector(`[data-error-for="${field}"]`);
    }

    function setError(input, field, message) {
      input.setAttribute('aria-invalid', message ? 'true' : 'false');
      const el = fieldError(field);
      if (el) el.textContent = message;
    }

    function resetDialogState() {
      form.reset();
      isSubmitting = false;
      submitBtn.removeAttribute('disabled');
      submitBtn.textContent = 'Book Demo';
      submitError.hidden = true;
      submitError.textContent = '';
      setError(nameInput, 'name', '');
      setError(emailInput, 'email', '');
      setError(mobileInput, 'mobile', '');
      formBody.hidden = false;
      successPanel.hidden = true;
    }

    function validate() {
      let valid = true;

      const name = nameInput.value.trim();
      if (name.length < 2) {
        setError(nameInput, 'name', 'Please enter your full name.');
        valid = false;
      } else {
        setError(nameInput, 'name', '');
      }

      const email = emailInput.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError(emailInput, 'email', 'Please enter a valid email address.');
        valid = false;
      } else {
        setError(emailInput, 'email', '');
      }

      const mobileDigits = mobileInput.value.replace(/[^0-9]/g, '');
      if (!/^[6-9][0-9]{9}$/.test(mobileDigits)) {
        setError(mobileInput, 'mobile', 'Please enter a valid 10-digit mobile number.');
        valid = false;
      } else {
        setError(mobileInput, 'mobile', '');
      }

      return valid ? { name, email, mobile: mobileDigits, education: educationInput.value || null } : null;
    }

    trigger.addEventListener('click', () => {
      resetDialogState();
      dialog.showModal();
    });

    closeBtn?.addEventListener('click', () => dialog.close());
    form.querySelectorAll('[data-demo-cancel], [data-demo-close-success]').forEach((btn) => {
      btn.addEventListener('click', () => dialog.close());
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting) return;

      const values = validate();
      if (!values) return;

      isSubmitting = true;
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = 'Submitting…';
      submitError.hidden = true;

      try {
        const client = await getSupabaseClient();
        const { error } = await client.from('marketing_leads').insert({
          name: values.name,
          email: values.email,
          mobile: values.mobile,
          program: PROGRAM_NAME,
          source: LEAD_SOURCE,
          education_status: values.education,
        });

        if (error) throw error;

        formBody.hidden = true;
        successPanel.hidden = false;
      } catch (err) {
        submitError.textContent = 'Something went wrong while submitting. Please try again.';
        submitError.hidden = false;
        isSubmitting = false;
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = 'Book Demo';
      }
    });
  }
</script>
