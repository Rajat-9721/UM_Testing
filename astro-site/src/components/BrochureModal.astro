---
/**
 * Brochure download popup. Rendered once per page; any button with
 * `data-brochure-trigger` opens it (see Hero.astro / StickyProgramPanel.astro).
 *
 * The visitor's email is verified with a 6-digit code (lead-otp Edge
 * Function) before the lead is saved as "Brochure download" and the
 * brochure PDF downloads. See LeadCaptureDialog.astro.
 */
import LeadCaptureDialog from './LeadCaptureDialog.astro';

const BROCHURE_URL = '/downloads/spit-ai-certification-brochure.pdf';
const PROGRAM_NAME = 'Professional Certification in AI';
---

<LeadCaptureDialog
  id="brochure"
  source="ai_brochure"
  program={PROGRAM_NAME}
  trigger="[data-brochure-trigger]"
  title="Download the AI Program Brochure"
  subtitle="We'll email you a 6-digit code to confirm it's really you. Your download starts right after."
  submitLabel="Send code"
  verifyLabel="Verify & Download"
  successTitle="You're verified"
  successMessage="Your download should start automatically."
  downloadUrl={BROCHURE_URL}
  downloadLabel="Download the brochure again"
/>
