---
import { Image } from 'astro:assets';
import Container from '../Container.astro';
import Section from '../Section.astro';
import classroom1 from '../../assets/images/classroom-session-1.jpeg';
import classroom2 from '../../assets/images/classroom-session-2.jpeg';
import ceremony from '../../assets/images/certification-ceremony.jpeg';

/**
 * Photo-first gallery: one photo per view inside a fixed wide frame,
 * sliding horizontally on native scroll-snap so touch swipes, trackpads
 * and keyboard scrolling all behave natively. Photos are never cropped
 * (people sit right at the edges of these shots) — any spare space in the
 * frame is filled by a blurred copy of the same photo.
 */
const moments = [
  {
    image: classroom1,
    alt: 'Hands-on classroom training session in progress',
    title: 'Hands-on classroom training',
    caption: 'Real interaction, guided learning.',
  },
  {
    image: classroom2,
    alt: 'Instructor-led training session with a presentation screen',
    title: 'Instructor-led sessions',
    caption: 'Practical, hands-on guidance at every step.',
  },
  {
    image: ceremony,
    alt: 'Learners holding their Utkarsh Minds certificates with their trainers',
    title: 'Certification day',
    caption: 'Learners receiving their Utkarsh Minds certificates.',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<Section theme="light" class="training-gallery">
  <Container>
    <div class="tg" data-tg>
      <div class="tg-head" data-reveal-group>
        <div>
          <p class="kicker" data-reveal>Training In Action</p>
          <h2 data-reveal>What learning with us actually looks like</h2>
        </div>

        <div class="tg-controls" data-reveal>
          <p class="tg-counter" aria-live="polite">
            <span data-tg-current>01</span><span class="tg-counter-sep">/</span>{pad(moments.length)}
          </p>
          <button type="button" class="tg-arrow" data-tg-prev aria-label="Previous photo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" class="tg-arrow" data-tg-next aria-label="Next photo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>

        <div class="tg-progress" aria-hidden="true">
          {moments.map((_, i) => <span class:list={['tg-progress-seg', { 'is-active': i === 0 }]} data-tg-seg><i class="tg-seg-fill" /></span>)}
        </div>
      </div>

      <div
        class="tg-viewport"
        data-tg-viewport
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        aria-label="Training photo gallery"
        data-reveal
      >
        <ul class="tg-track">
          {
            moments.map((m, i) => (
              <li
                class:list={['tg-slide', { 'is-active': i === 0 }]}
                data-tg-slide
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${moments.length}: ${m.title}`}
              >
                <figure class="tg-photo">
                  <Image src={m.image} alt="" width={480} class="tg-backdrop" loading="lazy" aria-hidden="true" />
                  <Image
                    src={m.image}
                    alt={m.alt}
                    widths={[480, 800, 1200, 1500].filter((w) => w <= m.image.width)}
                    sizes="(max-width: 960px) 94vw, 640px"
                    class="tg-img"
                    loading="lazy"
                  />
                  <figcaption class="tg-caption">
                    <span class="tg-caption-index">{pad(i + 1)}</span>
                    <span class="tg-caption-text">
                      <strong>{m.title}</strong>
                      <span>{m.caption}</span>
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>

    </div>
  </Container>
</Section>

<style>
  :global(.section.training-gallery) {
    padding-block: var(--space-16);
  }

  /* Two columns: heading + controls on the left, a compact photo frame
     (sized like the project screenshots) on the right. */
  .tg {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 640px);
    gap: var(--space-12);
    align-items: center;
  }

  .tg-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-2);
  }

  h2 {
    color: var(--color-primary-dark);
    margin-bottom: 0;
  }

  .tg-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .tg-counter {
    margin: 0 var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .tg-counter-sep {
    margin-inline: 0.35em;
    color: var(--color-accent);
  }

  /* Squared, hairline arrows — deliberately unlike the round buttons used
     by the milestones and projects carousels. */
  .tg-arrow {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-primary);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .tg-arrow:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .tg-arrow:focus-visible,
  .tg-viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .tg-viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    border-radius: var(--radius-lg);
  }

  .tg-viewport::-webkit-scrollbar {
    display: none;
  }

  .tg-track {
    display: flex;
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One photo per view: every slide fills the whole frame */
  .tg-slide {
    flex: 0 0 100%;
    min-width: 0;
    aspect-ratio: 16 / 9;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .tg-photo {
    position: relative;
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-primary-dark);
  }

  .tg-photo :global(.tg-backdrop) {
    position: absolute;
    inset: -8%;
    width: 116%;
    height: 116%;
    object-fit: cover;
    filter: blur(24px) saturate(0.9) brightness(0.8);
  }

  .tg-photo :global(.tg-img) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.8s var(--reveal-easing);
  }

  .tg-slide:hover .tg-photo :global(.tg-img) {
    transform: scale(1.02);
  }

  .tg-caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-4) var(--space-3);
    background: linear-gradient(to top, rgba(18, 40, 31, 0.85), rgba(18, 40, 31, 0));
    color: var(--color-dark-text);
  }

  .tg-caption-index {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--color-golden-subtle);
  }

  .tg-caption-text {
    display: flex;
    flex-direction: column;
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .tg-caption-text strong {
    font-size: var(--text-base);
    color: #fff;
  }

  .tg-caption-text span {
    color: var(--color-dark-text-muted);
  }

  .tg-progress {
    display: flex;
    gap: var(--space-2);
    max-width: 240px;
  }

  .tg-progress-seg {
    position: relative;
    flex: 1;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--color-border);
    overflow: hidden;
  }

  /* The active segment fills over the autoplay interval — this animation
     is also the autoplay timer (see lib/carouselAutoplay.ts). */
  .tg-seg-fill {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .tg-progress-seg.is-active .tg-seg-fill {
    animation: autoplay-fill var(--autoplay-ms, 3000ms) linear forwards;
  }

  :global(.is-autoplay-paused) .tg-seg-fill {
    animation-play-state: paused !important;
  }

  @keyframes autoplay-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 960px) {
    .tg {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .tg-head {
      gap: var(--space-4);
    }

    .tg-viewport {
      width: 100%;
      max-width: 640px;
    }
  }

  @media (max-width: 640px) {
    .tg-caption {
      padding: var(--space-8) var(--space-3) var(--space-3);
    }

    .tg-caption-index {
      font-size: var(--text-lg);
    }

    .tg-caption-text {
      font-size: var(--text-xs);
    }

    .tg-caption-text strong {
      font-size: var(--text-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tg-viewport {
      scroll-behavior: auto;
    }

    .tg-photo :global(.tg-img) {
      transition: none;
    }
  }
</style>

<script>
  import { initCarouselAutoplay } from '../../lib/carouselAutoplay';

  /**
   * Native scroll-snap does the sliding; this only tracks which frame is
   * current, wires the arrows, and hands auto-advance to the shared
   * autoplay helper (keeps sliding on hover; paused on keyboard focus, touch, off-screen).
   */
  const AUTOPLAY_MS = 3000;

  document.querySelectorAll<HTMLElement>('[data-tg]').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('[data-tg-viewport]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-tg-slide]'));
    const segs = Array.from(root.querySelectorAll<HTMLElement>('[data-tg-seg]'));
    const current = root.querySelector<HTMLElement>('[data-tg-current]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-tg-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-tg-next]');
    if (!viewport || slides.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;

    function setActive(i: number) {
      if (i === active) return;
      active = i;
      slides.forEach((s, n) => s.classList.toggle('is-active', n === i));
      segs.forEach((s, n) => s.classList.toggle('is-active', n === i));
      if (current) current.textContent = String(i + 1).padStart(2, '0');
    }

    function slideLeft(i: number) {
      return slides[i].offsetLeft - slides[0].offsetLeft;
    }

    function goTo(i: number) {
      const n = (i + slides.length) % slides.length;
      viewport!.scrollTo({ left: slideLeft(n), behavior: reducedMotion ? 'auto' : 'smooth' });
    }

    // "Active" is whichever slide is nearest the current scroll position.
    let ticking = false;
    viewport.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const x = viewport!.scrollLeft;
          let best = 0;
          slides.forEach((_, n) => {
            if (Math.abs(slideLeft(n) - x) < Math.abs(slideLeft(best) - x)) best = n;
          });
          setActive(best);
        });
      },
      { passive: true }
    );

    prevBtn?.addEventListener('click', () => goTo(active - 1));
    nextBtn?.addEventListener('click', () => goTo(active + 1));

    initCarouselAutoplay({ root, watch: viewport, intervalMs: AUTOPLAY_MS, pauseOnHover: false, next: () => goTo(active + 1) });
  });
</script>
