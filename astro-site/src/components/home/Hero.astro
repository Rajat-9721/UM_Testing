---
import { Image } from 'astro:assets';
import Container from '../Container.astro';
import Button from '../Button.astro';
import spitLogo from '../../assets/brand/spit-logo-hero.png';

import pythonIcon from '../../assets/logos/python.svg?raw';
import tensorflowIcon from '../../assets/logos/tensorflow.svg?raw';
import pytorchIcon from '../../assets/logos/pytorch.svg?raw';
import openaiIcon from '../../assets/logos/openai.svg?raw';
import dataIcon from '../../assets/logos/data-science.svg?raw';
import mlIcon from '../../assets/logos/machine-learning.svg?raw';

const stats = [
  { value: '2012', label: 'Training since' },
  { value: '90%', label: 'Exam success rate' },
  { value: '60%', label: 'Hands-on practical time' },
];

/**
 * Satellites sit evenly on one orbit (radius 40 on the 0–100 square the
 * stage and SVG share), 60° apart, so every chip is equidistant from the
 * logo and the orbit ring passes straight through them. Real official
 * brand marks (Simple Icons, CC0) for Python/TensorFlow/PyTorch/OpenAI;
 * the ML and Data Science entries are generic in-house glyphs.
 */
const HUB = { x: 50, y: 50 };
const ORBIT_R = 40;

const rawSatellites = [
  { key: 'python', label: 'Python', icon: pythonIcon, angle: -120, tint: '#3776AB' },
  { key: 'tensorflow', label: 'TensorFlow', icon: tensorflowIcon, angle: -60, tint: '#FF6F00' },
  { key: 'pytorch', label: 'PyTorch', icon: pytorchIcon, angle: 0, tint: '#EE4C2C' },
  { key: 'openai', label: 'Generative AI', icon: openaiIcon, angle: 60, tint: '#412991' },
  { key: 'ml', label: 'Machine Learning', icon: mlIcon, angle: 120, tint: 'var(--color-accent)' },
  { key: 'data', label: 'Data Science', icon: dataIcon, angle: 180, tint: 'var(--color-primary-light)' },
];

/**
 * Each connection is a gentle quadratic curve from the hub to its chip —
 * the control point is offset perpendicular to the hub->node vector, sign
 * alternating per node so neighbouring paths bow in different directions.
 */
const satellites = rawSatellites.map((s, i) => {
  const rad = (s.angle * Math.PI) / 180;
  const x = HUB.x + ORBIT_R * Math.cos(rad);
  const y = HUB.y + ORBIT_R * Math.sin(rad);
  const perpX = -Math.sin(rad);
  const perpY = Math.cos(rad);
  const bow = (i % 2 === 0 ? 1 : -1) * 5;
  const midX = (HUB.x + x) / 2 + perpX * bow;
  const midY = (HUB.y + y) / 2 + perpY * bow;
  const path = `M ${HUB.x} ${HUB.y} Q ${midX.toFixed(2)} ${midY.toFixed(2)} ${x.toFixed(2)} ${y.toFixed(2)}`;
  // Negative delays: every loop is already mid-flight on first paint, so
  // there is no initial wait or synchronized "pop" when the page loads.
  return { ...s, x, y, path, delay: `${-i}s` };
});
---

<section class="hero">
  <Container class="hero__inner">
    <div class="hero-copy">
      <p class="eyebrow hero-reveal" style="--d: 0">A Program Driven by Sardar Patel Institute of Technology</p>
      <h1 class="hero-reveal" style="--d: 1">
        Master Artificial Intelligence &amp; Agentic AI — with real mentors and real projects.
      </h1>
      <p class="lede hero-reveal" style="--d: 2">
        Utkarsh Minds delivers hands-on, industry-oriented training in Data Science, Machine
        Learning and Artificial Intelligence — built around live projects, practical case studies
        and internship &amp; placement support.
      </p>

      <div class="hero-ctas hero-reveal" style="--d: 3">
        <Button href="#enquire" variant="accent">Enquire Now</Button>
        <Button type="button" variant="outline-white" data-brochure-trigger>
          Download AI Program Brochure
        </Button>
      </div>

      <dl class="hero-stats hero-reveal" style="--d: 4">
        {
          stats.map((s) => (
            <div class="hero-stat">
              <dt>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero-visual hero-reveal" style="--d: 2">
      <div class="logo-stage">
        <svg class="stage-lines" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <circle class="stage-orbit" cx="50" cy="50" r={ORBIT_R} />
          {satellites.map((s) => <path d={s.path} class="stage-link" />)}
          {
            /* Signal pulse: a short dash travelling hub -> chip along the
               same curve via stroke-dashoffset (pathLength-normalised).
               Starts hidden under the logo and ends hidden under the chip,
               so it never pops in or out. */
            satellites.map((s) => (
              <path d={s.path} class="stage-signal" pathLength="100" style={`animation-delay: ${s.delay};`} />
            ))
          }
        </svg>

        <div class="logo-core">
          <span class="logo-halo" aria-hidden="true"></span>
          <div class="logo-core-disc">
            <Image
              src={spitLogo}
              alt="Sardar Patel Institute of Technology (SPIT) logo"
              width={240}
              densities={[1, 2]}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

        {
          satellites.map((s) => (
            <div class:list={['satellite', { 'satellite--top': s.angle < 0 }]} style={`left:${s.x.toFixed(2)}%; top:${s.y.toFixed(2)}%;`} aria-hidden="true">
              <div class="satellite-float" style={`animation-delay: ${s.delay};`}>
                <span class="satellite-chip" style={`animation-delay: ${s.delay};`}>
                  <span class="satellite-icon" style={`color:${s.tint};`} set:html={s.icon} />
                </span>
                <span class="satellite-label">{s.label}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    background: var(--gradient-signature);
    color: var(--color-dark-text);
    overflow: hidden;
    padding-block: var(--space-16) var(--space-10);
  }

  :global(.hero__inner) {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-16);
    align-items: center;
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  h1 {
    color: #fff;
    font-size: var(--text-5xl);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .lede {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-dark-text-muted);
    max-width: 56ch;
    margin-bottom: var(--space-6);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-dark-border);
  }

  .hero-stat dt {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: #fff;
  }

  .hero-stat dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-dark-text-muted);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  /* ---- Logo stage: the SPIT emblem at the centre of a calm, continuously
     running technology orbit. Every loop's first and last keyframes are
     identical, so nothing ever jumps, resets or blinks between cycles. ---- */

  .logo-stage {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1 / 1;
  }

  .stage-lines {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .stage-orbit {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 0.35;
    stroke-dasharray: 0.8 2;
    stroke-linecap: round;
    opacity: 0.75;
    transform-box: fill-box;
    transform-origin: center;
    animation: orbit-spin 90s linear infinite;
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Brass (not the pale gold) so the connections read clearly over both
     the dark-green and the cream end of the hero gradient. */
  .stage-link {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 0.45;
    stroke-dasharray: 1.4 1.2;
    stroke-linecap: round;
    opacity: 0.85;
  }

  /* Dash of 8 then a 200 gap (on a pathLength of 100): exactly one pulse is
     ever on the curve, travelling from offset 8 (hidden before the start)
     to -100 (just past the end), then resting until the next cycle. */
  .stage-signal {
    fill: none;
    stroke: #f3d9a4;
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 8 200;
    filter: drop-shadow(0 0 1.2px rgba(190, 138, 61, 0.9));
    stroke-dashoffset: 8;
    animation: signal-travel 6s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }

  @keyframes signal-travel {
    0% {
      stroke-dashoffset: 8;
    }
    55%,
    100% {
      stroke-dashoffset: -100;
    }
  }

  .logo-core {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 48%;
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
  }

  /* Soft brass glow that breathes behind the disc — opacity/scale only,
     composited, so it stays smooth on low-end mobile GPUs. */
  .logo-halo {
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(217, 196, 143, 0.45) 0%, rgba(217, 196, 143, 0) 68%);
    animation: halo-breathe 6s ease-in-out infinite;
  }

  @keyframes halo-breathe {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.94);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  /* Warm white disc framing the transparent SPIT seal: a faint maroon
     inner ring echoes the seal's own colour, a brass hairline and soft
     outer glow tie it back to the site palette. */
  .logo-core-disc {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 38%, #ffffff 0%, #fdfaf4 55%, #f3ead8 100%);
    border: 1px solid var(--color-golden-subtle);
    box-shadow:
      inset 0 0 0 5px #fff,
      inset 0 0 0 6px rgba(143, 38, 38, 0.18),
      0 0 0 6px rgba(250, 246, 238, 0.14),
      0 18px 40px rgba(10, 24, 18, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10%;
  }

  .logo-core-disc :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Anchor the chip's centre (not the chip+label block) on the orbit point:
     -28px is half the 56px chip, so lines end exactly under the chip. */
  .satellite {
    position: absolute;
    z-index: 1;
    transform: translate(-50%, -28px);
  }

  /* Top-row chips put their label above the chip, pointing away from the
     logo, so a label never overlaps the disc on small screens. */
  .satellite--top {
    transform: translate(-50%, calc(-100% + 28px));
  }

  .satellite--top .satellite-float {
    flex-direction: column-reverse;
  }

  .satellite-float {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    animation: satellite-float 6s ease-in-out infinite;
  }

  @keyframes satellite-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .satellite-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--color-bg);
    box-shadow: var(--shadow-md);
    animation: chip-receive 6s ease-in-out infinite;
  }

  /* Soft brass ring as this node's signal arrives (end of signal-travel's
     travel window at ~55%), then eases back to rest. */
  @keyframes chip-receive {
    0%,
    46%,
    80%,
    100% {
      box-shadow: 0 0 0 0 rgba(190, 138, 61, 0), var(--shadow-md);
    }
    56% {
      box-shadow: 0 0 0 6px rgba(190, 138, 61, 0.22), var(--shadow-md);
    }
  }

  .satellite-icon {
    display: flex;
    width: 26px;
    height: 26px;
  }

  .satellite-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }

  /* Solid cream pill behind every label so it reads clearly over both the
     dark-green and cream ends of the hero gradient — never relying on
     the background color underneath for contrast. */
  .satellite-label {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
    background: var(--color-bg);
    padding: 3px 8px;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
  }

  /* On-load reveal: purposeful, once, staggered — not a looping effect */
  .hero-reveal {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-rise 0.8s var(--reveal-easing) forwards;
    animation-delay: calc(var(--d, 0) * 110ms);
  }

  @keyframes hero-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .stage-orbit,
    .stage-signal,
    .logo-halo,
    .satellite-float,
    .satellite-chip {
      animation: none;
    }
    .stage-signal {
      opacity: 0;
    }
  }

  @media (max-width: 1024px) {
    .hero {
      /* Stacked layout puts copy below the visual, so the gradient runs
         top-to-bottom and stays mostly dark until content ends, only
         fading to cream in the empty space near the section's bottom edge. */
      background: var(--gradient-signature-vertical);
    }

    :global(.hero__inner) {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      order: -1;
    }

    .logo-stage {
      max-width: 340px;
      margin-inline: auto;
    }
  }

  @media (max-width: 768px) {
    h1 {
      font-size: var(--text-4xl);
    }
  }

  @media (max-width: 640px) {
    .logo-stage {
      max-width: 280px;
    }

    .satellite {
      transform: translate(-50%, -22px);
    }

    .satellite--top {
      transform: translate(-50%, calc(-100% + 22px));
    }

    .satellite-chip {
      width: 44px;
      height: 44px;
    }

    .satellite-icon {
      width: 20px;
      height: 20px;
    }

    .satellite-label {
      font-size: 8px;
    }
  }
</style>
