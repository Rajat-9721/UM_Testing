---
import Container from '../Container.astro';
import Section from '../Section.astro';
import StickyProgramPanel from './StickyProgramPanel.astro';

/**
 * Source of truth: "Professional_Certification_AI_Agentic_AI_FAQ.pdf",
 * "Revised Curriculum – 200 Hours" table. Matches the official brochure
 * figures exactly, module-for-module — including the total.
 */
const modules = [
  { name: 'Python Programming', hours: 20 },
  { name: 'Statistics in Python', hours: 20 },
  { name: 'Machine Learning', hours: 30 },
  { name: 'Deep Learning', hours: 20 },
  { name: 'Natural Language Processing', hours: 20 },
  { name: 'Generative AI + Agentic AI', hours: 25 },
  { name: 'Computer Vision', hours: 20 },
  { name: 'Power BI', hours: 20 },
  { name: 'Big Data', hours: 20 },
  { name: 'Interview Preparation + Resume Building + Soft Skills Training', hours: 5 },
];
const totalHours = modules.reduce((sum, m) => sum + m.hours, 0);

const highlights = [
  'Hybrid delivery — offline at SPIT, or live online via Google Meet',
  'Hands-on teaching with recorded sessions',
  'Industry-oriented syllabus and interview preparation',
  '100% internship and placement assistance',
];

const panelFacts = [
  { label: 'Delivery', value: 'Hybrid — offline or online (Google Meet)' },
  { label: 'Offline center', value: 'SPIT, Andheri (West), Mumbai' },
  { label: 'Eligibility', value: 'Diploma / Graduation / PG / PhD' },
  { label: 'Academic partner', value: 'SPIT, Mumbai' },
];
---

<Section theme="light" id="programs">
  <Container>
    <div class="spotlight">
      <div class="spotlight-main">
        <p class="kicker" data-reveal>Flagship Program</p>
        <h2 class="spotlight-title" data-reveal>Professional Certification in Artificial Intelligence</h2>
        <p class="partner-line" data-reveal>
          In academic partnership with <strong>Sardar Patel Institute of Technology (SPIT)</strong>,
          Bhavan's Campus, Mumbai.
        </p>

        <ul class="highlight-list" data-reveal>
          {highlights.map((h) => <li>{h}</li>)}
        </ul>

        <div class="curriculum" data-reveal>
          <h3>Curriculum</h3>
          <ul class="module-list" data-reveal-group>
            {
              modules.map((m) => (
                <li data-reveal>
                  <span class="module-name">{m.name}</span>
                  <span class="module-hours">{m.hours} hrs</span>
                </li>
              ))
            }
            <li class="module-total">
              <span class="module-name">Total</span>
              <span class="module-hours">{totalHours} hrs</span>
            </li>
          </ul>
        </div>
      </div>

      <StickyProgramPanel
        name="Professional Certification in AI"
        facts={panelFacts}
      />
    </div>
  </Container>
</Section>

<style>
  .kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-3);
  }

  .spotlight-title {
    max-width: 26ch;
    margin-bottom: var(--space-4);
  }

  .partner-line {
    color: var(--color-text-muted);
    margin-bottom: var(--space-12);
  }

  .spotlight {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  .highlight-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }

  .highlight-list li {
    position: relative;
    padding-inline-start: var(--space-6);
    color: var(--color-text);
  }

  .highlight-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    background: var(--color-accent);
  }

  .curriculum h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .module-list {
    display: flex;
    flex-direction: column;
  }

  .module-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .module-list li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .module-total {
    border-bottom: none !important;
  }

  .module-total .module-name,
  .module-total .module-hours {
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .module-name {
    color: var(--color-text);
    font-weight: 600;
  }

  .module-hours {
    color: var(--color-text-muted);
    white-space: nowrap;
    font-family: var(--font-display);
  }

  @media (max-width: 900px) {
    .spotlight {
      grid-template-columns: 1fr;
    }
  }
</style>
