---
import { Image } from 'astro:assets';
import Container from '../Container.astro';
import Section from '../Section.astro';
import projectP1 from '../../assets/images/projects/Project-p1.png';
import projectP2 from '../../assets/images/projects/Project-p2.png';
import projectP3 from '../../assets/images/projects/Project-p3.jpeg';

/**
 * Portfolio-style project showcase. Everything below is read directly off
 * the project screenshots (window titles, on-screen overlays). Libraries
 * and frameworks are intentionally NOT named until the actual stack is
 * confirmed — add a `stack` entry per project once known and it renders
 * as extra chips.
 */
const projects = [
  {
    image: projectP1,
    window: 'Real-Time Emotion Detection',
    title: 'Real-Time Emotion Detection',
    summary:
      'A live webcam app that finds every face in the frame and labels its expression with a confidence score — “Neutral 80.2%”, “Happy 99.6%” — as it happens.',
    problem: 'Turns facial expressions into a measurable, real-time signal a program can react to.',
    steps: [
      'Captures frames from a live webcam feed',
      'Detects each face and draws a bounding box around it',
      'Classifies every face into an emotion with a confidence score',
      'Overlays labels, live FPS and a face count on the video',
    ],
    tags: ['Computer Vision', 'Face Detection', 'Emotion Classification', 'Real-time Video'],
  },
  {
    image: projectP2,
    window: 'Monkey Face Filter',
    title: 'Monkey Face Filter',
    summary:
      'An AR-style camera filter that tracks every face on screen and replaces it with a monkey face that follows the person as they move.',
    problem: 'Recreates, from scratch, the technique behind social-media camera filters.',
    steps: [
      'Reads the live camera stream frame by frame',
      'Locates each face and tracks its position and size',
      'Scales and aligns the monkey overlay to fit each face',
      'Blends the overlay into the frame so it moves with the person',
    ],
    tags: ['Computer Vision', 'Face Tracking', 'Image Overlay / AR', 'Real-time Video'],
  },
  {
    image: projectP3,
    window: 'Telegram · @Aparna_Health_Assistant_bot',
    title: 'AYUSH Recipe Chatbot',
    summary:
      'A Telegram chatbot that recommends traditional recipes from the AYUSH Systems of Medicine — ask “What are the ingredients for Ragi and Banana Smoothie?” and get the full recipe back.',
    problem:
      'Makes traditional food knowledge easy to discover through conversation, grounded in a trusted source instead of an AI’s guesswork.',
    steps: [
      'Uses Vikaspedia’s “Traditional Food Recipes from AYUSH Systems of Medicine” as the knowledge source',
      'Retrieves the recipes relevant to each user question (RAG)',
      'Passes that context to a Generative AI model to compose the answer',
      'Delivers recipes, ingredients and instructions through a live Telegram bot',
    ],
    tags: ['Generative AI', 'RAG', 'Telegram Bot', 'AYUSH Knowledge'],
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<Section theme="dark" id="student-projects" class="student-projects">
  <Container>
    <div class="sp" data-sp>
      <div class="sp-head" data-reveal-group>
        <p class="kicker" data-reveal>Student Projects</p>
        <h2 data-reveal>From learning to building</h2>
        <p class="sp-lede" data-reveal>
          Real projects built by our learners — what they made, and how they made it.
        </p>
      </div>

      <div class="sp-viewport" role="region" aria-roledescription="carousel" aria-label="Student projects" data-reveal>
        <div class="sp-track" data-sp-track>
          {
            projects.map((p, i) => (
              <article
                class="sp-slide"
                data-sp-slide
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${projects.length}: ${p.title}`}
                aria-hidden={i === 0 ? undefined : 'true'}
                inert={i === 0 ? undefined : true}
              >
                <div class="sp-media">
                  <div class="sp-window">
                    <div class="sp-window-bar" aria-hidden="true">
                      <span class="sp-window-dots">
                        <i />
                        <i />
                        <i />
                      </span>
                      <span class="sp-window-title">{p.window}</span>
                    </div>
                    <div class="sp-window-body">
                      <Image
                        src={p.image}
                        alt={`Screenshot of the ${p.title} student project running`}
                        densities={[1, 2]}
                        loading="lazy"
                      />
                    </div>
                  </div>
                </div>

                <div class="sp-info">
                  <p class="sp-index">Project {pad(i + 1)}</p>
                  <h3>{p.title}</h3>
                  <p class="sp-summary">{p.summary}</p>

                  <p class="sp-problem">
                    <span>Problem it solves</span>
                    {p.problem}
                  </p>

                  <h4 class="sp-subhead">How it was built</h4>
                  <ol class="sp-steps">
                    {p.steps.map((s) => <li>{s}</li>)}
                  </ol>

                  <ul class="sp-tags" aria-label="Techniques used">
                    {p.tags.map((t) => <li>{t}</li>)}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="sp-nav">
        <div class="sp-tabs" role="tablist" aria-label="Choose a project">
          {
            projects.map((p, i) => (
              <button
                type="button"
                role="tab"
                class:list={['sp-tab', { 'is-active': i === 0 }]}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-sp-tab
              >
                <span class="sp-tab-num">{pad(i + 1)}</span>
                <span class="sp-tab-name">{p.title}</span>
                <span class="sp-tab-fill" aria-hidden="true" />
              </button>
            ))
          }
        </div>

        <div class="sp-arrows">
          <button type="button" class="sp-arrow" data-sp-prev aria-label="Previous project">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" class="sp-arrow" data-sp-next aria-label="Next project">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  :global(.section.student-projects) {
    padding-block: var(--space-16);
  }

  .sp-head {
    max-width: 640px;
    margin-bottom: var(--space-10);
  }

  .kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  h2 {
    color: #fff;
    margin-bottom: var(--space-3);
  }

  .sp-lede {
    color: var(--color-dark-text-muted);
    margin: 0;
  }

  /* Clips the sliding track so it can never widen the page */
  .sp-viewport {
    overflow: hidden;
    touch-action: pan-y;
  }

  .sp-track {
    display: flex;
    transition: transform 0.7s var(--reveal-easing);
    will-change: transform;
  }

  .sp-track.is-dragging {
    transition: none;
  }

  .sp-slide {
    flex: 0 0 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: center;
    padding: var(--space-8);
    border: 1px solid var(--color-dark-border);
    border-radius: var(--radius-xl);
    background: var(--color-dark-bg-alt);
    opacity: 0.35;
    transition: opacity 0.6s ease;
  }

  .sp-slide:not([aria-hidden]) {
    opacity: 1;
  }

  /* ---- Screenshot presented inside an app-window frame ---- */
  .sp-window {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0d1511;
    border: 1px solid var(--color-dark-border);
    box-shadow: 0 30px 50px rgba(0, 0, 0, 0.35);
    transition: transform 0.4s var(--reveal-easing), box-shadow 0.4s ease;
  }

  .sp-slide:hover .sp-window {
    transform: translateY(-4px);
    box-shadow: 0 36px 60px rgba(0, 0, 0, 0.45);
  }

  .sp-window-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: rgba(248, 244, 234, 0.06);
    border-bottom: 1px solid var(--color-dark-border);
  }

  .sp-window-dots {
    display: flex;
    gap: 5px;
  }

  .sp-window-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(248, 244, 234, 0.22);
  }

  .sp-window-dots i:first-child {
    background: var(--color-accent);
  }

  .sp-window-title {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: var(--text-xs);
    color: var(--color-dark-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sp-window-body {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sp-window-body :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ---- Project details ---- */
  .sp-index {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-golden-subtle);
    margin-bottom: var(--space-1);
  }

  h3 {
    color: #fff;
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
  }

  .sp-summary {
    color: var(--color-dark-text-muted);
    margin-bottom: var(--space-4);
  }

  .sp-problem {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    color: var(--color-dark-text);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }

  .sp-problem span,
  .sp-subhead {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-golden-subtle);
  }

  .sp-subhead {
    margin-bottom: var(--space-3);
  }

  /* Build pipeline: numbered steps joined by a thin vertical rail */
  .sp-steps {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    counter-reset: step;
  }

  .sp-steps li {
    position: relative;
    counter-increment: step;
    padding: 0 0 var(--space-3) 2.25rem;
    font-size: var(--text-sm);
    color: var(--color-dark-text);
  }

  .sp-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -1px;
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .sp-steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(0.75rem - 0.5px);
    top: 1.5rem;
    bottom: 0;
    width: 1px;
    background: var(--color-dark-border);
  }

  .sp-steps li:last-child {
    padding-bottom: 0;
  }

  .sp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sp-tags li {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background: rgba(190, 138, 61, 0.14);
    color: var(--color-golden-subtle);
    border: 1px solid rgba(190, 138, 61, 0.3);
  }

  /* ---- Navigation: named project tabs + round arrows ---- */
  .sp-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .sp-tabs {
    display: flex;
    gap: var(--space-6);
    min-width: 0;
  }

  .sp-tab {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border: none;
    background: none;
    color: var(--color-dark-text-muted);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    text-align: left;
    transition: color 0.2s ease;
  }

  .sp-tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--reveal-easing);
  }

  .sp-tab:hover,
  .sp-tab.is-active {
    color: #fff;
  }

  /* Active tab: a dim full-width rail, with the brass fill running across
     it over the autoplay interval — that animation is also the autoplay
     timer (see lib/carouselAutoplay.ts). */
  .sp-tab.is-active::after {
    transform: scaleX(1);
    background: rgba(190, 138, 61, 0.3);
  }

  .sp-tab-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .sp-tab.is-active .sp-tab-fill {
    animation: autoplay-fill var(--autoplay-ms, 6000ms) linear forwards;
  }

  :global(.is-autoplay-paused) .sp-tab-fill {
    animation-play-state: paused !important;
  }

  @keyframes autoplay-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }


  .sp-tab-num {
    font-family: var(--font-display);
    color: var(--color-accent);
  }

  .sp-arrows {
    display: flex;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .sp-arrow {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-dark-border);
    background: transparent;
    color: var(--color-dark-text);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .sp-arrow:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-primary-dark);
  }

  .sp-tab:focus-visible,
  .sp-arrow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 960px) {
    .sp-slide {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      align-items: start;
      padding: var(--space-6);
    }

    .sp-media {
      max-width: 620px;
    }
  }

  @media (max-width: 640px) {
    .sp-slide {
      padding: var(--space-4);
      border-radius: var(--radius-lg);
    }

    h3 {
      font-size: var(--text-2xl);
    }

    .sp-tab-name {
      display: none;
    }

    .sp-tabs {
      gap: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-track,
    .sp-slide,
    .sp-window,
    .sp-tab::after {
      transition: none;
    }
  }
</style>

<script>
  import { initCarouselAutoplay } from '../../lib/carouselAutoplay';

  const AUTOPLAY_MS = 6000;

  /**
   * One project per view, slid with a transform on the track. Tabs, arrows,
   * left/right keys and touch swipes all route through goTo(); off-screen
   * slides are made inert so keyboard and screen-reader users only ever
   * reach the visible project. Auto-advances on a longer interval than the
   * photo gallery since each slide has text to read, and pauses on hover.
   */
  document.querySelectorAll<HTMLElement>('[data-sp]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-sp-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-sp-slide]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-sp-tab]'));
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-sp-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-sp-next]');
    if (!track || slides.length === 0) return;

    let active = 0;

    function goTo(i: number) {
      active = (i + slides.length) % slides.length;
      track!.style.transform = `translate3d(${-active * 100}%, 0, 0)`;
      slides.forEach((s, n) => {
        const on = n === active;
        s.toggleAttribute('inert', !on);
        if (on) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      tabs.forEach((t, n) => {
        t.classList.toggle('is-active', n === active);
        t.setAttribute('aria-selected', String(n === active));
      });
    }

    tabs.forEach((t, n) => t.addEventListener('click', () => goTo(n)));
    initCarouselAutoplay({
      root,
      watch: track.parentElement!,
      intervalMs: AUTOPLAY_MS,
      next: () => goTo(active + 1),
    });
    prevBtn?.addEventListener('click', () => goTo(active - 1));
    nextBtn?.addEventListener('click', () => goTo(active + 1));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goTo(active - 1);
      else if (e.key === 'ArrowRight') goTo(active + 1);
    });

    // Touch swipe: the track follows the finger, then settles on the
    // nearest project. `touch-action: pan-y` keeps vertical page scroll.
    const viewport = track.parentElement!;
    let startX = 0;
    let startY = 0;
    let dx = 0;
    let dragging = false;

    viewport.addEventListener(
      'touchstart',
      (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        dx = 0;
        dragging = false;
      },
      { passive: true }
    );

    viewport.addEventListener(
      'touchmove',
      (e) => {
        const mx = e.touches[0].clientX - startX;
        const my = e.touches[0].clientY - startY;
        if (!dragging && Math.abs(mx) > 8 && Math.abs(mx) > Math.abs(my)) {
          dragging = true;
          track!.classList.add('is-dragging');
        }
        if (!dragging) return;
        dx = mx;
        const width = viewport.clientWidth;
        track!.style.transform = `translate3d(${-active * width + dx}px, 0, 0)`;
      },
      { passive: true }
    );

    viewport.addEventListener('touchend', () => {
      if (!dragging) return;
      dragging = false;
      track!.classList.remove('is-dragging');
      const threshold = viewport.clientWidth * 0.18;
      if (dx < -threshold && active < slides.length - 1) goTo(active + 1);
      else if (dx > threshold && active > 0) goTo(active - 1);
      else goTo(active);
    });
  });
</script>
