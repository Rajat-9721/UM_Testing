---
import Button from '../Button.astro';

interface Props {
  name: string;
  facts: { label: string; value: string }[];
}

const { name, facts } = Astro.props;
---

<aside class="panel">
  <h3>{name}</h3>

  <dl class="panel-facts">
    {
      facts.map((f) => (
        <div class="fact">
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="panel-ctas">
    <Button href="#enquire" variant="primary" class="panel-btn">Enquire Now</Button>
    <Button href="/downloads/spit-ai-certification-brochure.pdf" variant="outline" class="panel-btn">
      Download Brochure
    </Button>
  </div>

  <div class="panel-admission">
    <p class="panel-admission-label">Program admission office (SPIT)</p>
    <a href="tel:+917718849238">+91 77188 49238</a>
    <a href="mailto:pranav.nerurkar@spit.ac.in">pranav.nerurkar@spit.ac.in</a>
  </div>
</aside>

<style>
  .panel {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    padding: var(--space-8);
    position: sticky;
    top: calc(80px + var(--space-8));
  }

  .panel h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-6);
    color: var(--color-primary);
  }

  .panel-facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .fact dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .fact dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .panel-ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .panel-ctas :global(.panel-btn) {
    width: 100%;
  }

  .panel-admission {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }

  .panel-admission-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .panel-admission a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .panel-admission a:hover {
    color: var(--color-accent-dark);
  }

  @media (max-width: 900px) {
    .panel {
      position: static;
    }
  }
</style>
