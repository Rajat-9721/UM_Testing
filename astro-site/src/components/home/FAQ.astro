---
import Container from '../Container.astro';
import Section from '../Section.astro';

const faqs = [
  {
    q: 'Is the AI Certification program online or offline?',
    a: 'It runs as an offline certification course at SPIT, Andheri (West), Mumbai.',
  },
  {
    q: 'Will session recordings be provided?',
    a: 'Yes, recordings are given so you can revisit any session.',
  },
  {
    q: 'Can I change my batch?',
    a: 'Yes, batch changes are allowed.',
  },
  {
    q: 'What if I miss a lecture?',
    a: 'Revision is provided if a lecture is missed.',
  },
  {
    q: 'What do I get with the course — notes, assignments, projects?',
    a: 'Notes, assignments, quizzes, projects and certification are all included.',
  },
  {
    q: 'Is placement assistance included?',
    a: 'Yes, the program includes placement assistance.',
  },
];
---

<Section theme="subtle" id="faq">
  <Container>
    <p class="kicker" data-reveal>FAQ</p>
    <h2 data-reveal>Common questions about the AI Certification program</h2>

    <div class="faq-list" data-reveal-group>
      {
        faqs.map((item) => (
          <details class="faq-item" data-reveal>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </Container>
</Section>

<style>
  .kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: var(--text-3xl);
    max-width: 40ch;
    margin-bottom: var(--space-6);
  }

  .faq-list {
    width: 68%;
    max-width: 780px;
    min-width: min(100%, 480px);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .faq-item {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    transition: border-color 250ms ease, box-shadow 250ms ease;
  }

  .faq-item:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
  }

  .faq-item summary {
    cursor: pointer;
    font-size: var(--text-base);
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-size: var(--text-lg);
    color: var(--color-accent);
    flex-shrink: 0;
    transition: var(--transition-fast);
  }

  .faq-item[open] summary::after {
    content: '\2212';
  }

  /* Native <details> hides non-summary children outright when closed
     (UA stylesheet `display:none`); overriding that to `block` lets us
     animate the reveal ourselves via max-height instead of an instant
     snap open/close. */
  .faq-item > p {
    display: block !important;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    margin-top: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: max-height 320ms ease, opacity 250ms ease, margin-top 320ms ease;
  }

  .faq-item[open] > p {
    max-height: 160px;
    opacity: 1;
    margin-top: var(--space-2);
  }

  @media (max-width: 900px) {
    .faq-list {
      width: 100%;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item > p {
      transition: none;
    }
  }
</style>
