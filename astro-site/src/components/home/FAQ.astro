---
import Container from '../Container.astro';
import Section from '../Section.astro';
import FAQAccordion from '../FAQAccordion.astro';

const faqs = [
  {
    q: 'Do I need prior programming knowledge?',
    a: 'No. Basic computer knowledge is sufficient.',
  },
  {
    q: 'Who can join the course?',
    a: 'Students pursuing graduation, diploma holders, graduates, postgraduates/PGDM, PhD scholars and working professionals can join.',
  },
  {
    q: 'What does the course cover?',
    a: 'Python, Statistics, Machine Learning, Deep Learning, NLP, Generative AI + Agentic AI, Computer Vision, Power BI, Big Data and career preparation.',
  },
  {
    q: 'What is the course duration?',
    a: '200 hours.',
  },
  {
    q: 'What are the class timings?',
    a: 'Saturday and Sunday, 9:00 AM to 1:00 PM.',
  },
  {
    q: 'Where are the classes conducted?',
    a: "In hybrid mode. Offline at Bhartiya Vidya Bhavan – Sardar Patel Institute of Technology (SPIT), Andheri West Campus, Mumbai – 400058. Students can also join online via Google Meet.",
  },
  {
    q: 'Is internship provided?',
    a: 'Yes. An internship is guaranteed for every student who successfully completes the training, through SPIT and applicable internship partners.',
  },
  {
    q: 'Is placement assistance provided?',
    a: 'Yes. 100% Internship and Placement Assistance is provided through SPIT for all eligible participants who successfully complete the training.',
  },
  {
    q: 'How much does the course cost?',
    a: '₹29,500/-, payable in up to 3 installments.',
  },
  {
    q: 'Is Agentic AI included?',
    a: 'Yes. Generative AI + Agentic AI is a dedicated 25-hour component.',
  },
  {
    q: 'What happens if I miss a class?',
    a: 'All lectures are recorded and stored on YouTube for on-demand viewing and self-paced learning.',
  },
];
---

<Section theme="subtle" id="faq">
  <Container>
    <p class="kicker" data-reveal>FAQ</p>
    <h2 data-reveal>Common questions about the AI Certification program</h2>

    <FAQAccordion items={faqs} class="home-faq-list" />

    <a class="view-all" data-reveal href="/faq">
      View all frequently asked questions
      <span aria-hidden="true">&rarr;</span>
    </a>
  </Container>
</Section>

<style>
  .kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: var(--text-3xl);
    max-width: 40ch;
    margin-bottom: var(--space-6);
  }

  :global(.home-faq-list) {
    width: 68%;
    max-width: 780px;
    min-width: min(100%, 480px);
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-weight: 600;
    color: var(--color-primary);
    transition: var(--transition-fast);
  }

  .view-all:hover {
    color: var(--color-accent);
    gap: var(--space-3);
  }

  @media (max-width: 900px) {
    :global(.home-faq-list) {
      width: 100%;
      max-width: 100%;
    }
  }
</style>
