---
import Container from '../Container.astro';
import Section from '../Section.astro';
import Button from '../Button.astro';
---

<Section theme="dark" id="enquire" class="cta-tight-section">
  <Container>
    <div class="cta" data-reveal>
      <div>
        <h2>Ready to start? Talk to us.</h2>
        <p>
          Reach out about the AI Certification program or any of our other courses — we'll get
          back to you directly.
        </p>
      </div>

      <div class="cta-actions">
        <Button href="https://wa.me/919619997797" variant="accent">WhatsApp Us</Button>
        <Button href="tel:+917718849238" variant="outline-white">Call +91 77188 49238</Button>
        <Button href="mailto:pranav.nerurkar@utkarshminds.com" variant="outline-white">
          Email Us
        </Button>
      </div>

      <address class="cta-address">
        Sardar Patel Institute of Technology (SPIT), Bhavan's Campus, Munshi Nagar, Andheri (West), Mumbai - 400058, Maharashtra, India
      </address>
    </div>
  </Container>
</Section>

<style>
  :global(.section.cta-tight-section) {
    padding-block: var(--space-12);
  }

  @media (max-width: 768px) {
    :global(.section.cta-tight-section) {
      padding-block: var(--space-8);
    }
  }

  h2 {
    color: #fff;
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .cta p {
    color: var(--color-dark-text-muted);
    max-width: 56ch;
    font-size: var(--text-base);
    margin-bottom: var(--space-6);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .cta-address {
    font-style: normal;
    color: var(--color-dark-text-muted);
    font-size: var(--text-xs);
    border-top: 1px solid var(--color-dark-border);
    padding-top: var(--space-4);
    max-width: 56ch;
  }
</style>
