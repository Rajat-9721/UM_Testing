---
import { Image } from 'astro:assets';
import Container from '../Container.astro';
import Section from '../Section.astro';

import drPranavNerurkar from '../../assets/faculty/dr-pranav-nerurkar.png';
import drAnupamaDeshpande from '../../assets/faculty/dr-anupama-deshpande.png';
import moreshwarDhaigude from '../../assets/faculty/moreshwar-dhaigude.png';
import shubhamMeshram from '../../assets/faculty/shubham-meshram.png';
import preetiGodabole from '../../assets/faculty/preeti-godabole.png';
import vishwanathChikareddi from '../../assets/faculty/vishwanath-chikareddi.png';
import sanjivSinh from '../../assets/faculty/sanjiv-sinh.png';
import pujaMishra from '../../assets/faculty/puja-mishra.png';
import palashIngle from '../../assets/faculty/palash-ingle.png';
import prajwalKhandare from '../../assets/faculty/prajwal-khandare.png';
import pradnyaSambary from '../../assets/faculty/pradnya-sambary.png';
import sapnaSingh from '../../assets/faculty/sapna-singh.png';
import gauravPangam from '../../assets/faculty/gaurav-pangam.png';
import jayPrakashPathak from '../../assets/faculty/jay-prakash-pathak.png';
import shreyaSahu from '../../assets/faculty/shreya-sahu.png';

/**
 * Source of truth: "Website details (1).pdf", pages 2-3 — faculty photos with
 * names/designations. `role` is the designation exactly as printed there;
 * `description` is a direct, literal restatement of that same designation
 * (no added credentials, years or claims beyond what the source states).
 *
 * `fit` + `focus` were tuned by simulating the exact crop this card box
 * produces (1.85:1) against every source photo and inspecting the result,
 * rather than guessing from headroom alone. That test showed the earlier
 * top-weighted positions were wrong: for a tight face-filling headshot,
 * biasing toward preserving hair/forehead space pushes the crop window up
 * and cuts the chin/mouth instead — the face needs to be *centered* on the
 * eyes/nose/mouth (a mid-range focus, ~40-70%), which crops hair/forehead
 * and shoulders instead of the face. `fit: 'contain'` is reserved for the
 * one photo (Sapna Singh) where the head sits so high in a full-body shot
 * that no crop window at this box ratio can include it — the full photo is
 * shown uncropped, centered against the card's own background.
 *
 * Vishwanath Chikareddi and Shreya Sahu had black vertical borders baked
 * into their extracted source photos; those were trimmed directly from the
 * asset files (src/assets/faculty) rather than papered over with CSS.
 */
const faculty = [
  { name: 'Dr. Pranav Nerurkar', role: 'Specialist – AI, Data Science', description: 'Specialist in Artificial Intelligence and Data Science.', image: drPranavNerurkar, fit: 'cover', focus: '50%' },
  { name: 'Dr. Anupama Deshpande', role: 'Specialist – Electronics/Electricals', description: 'Specialist in Electronics and Electrical Engineering.', image: drAnupamaDeshpande, fit: 'cover', focus: '55%' },
  { name: 'Moreshwar Dhaigude', role: 'Specialist – Mathematics', description: 'Specialist in Mathematics.', image: moreshwarDhaigude, fit: 'cover', focus: '48%' },
  { name: 'Shubham Meshram', role: 'Specialist – FinTech', description: 'Specialist in FinTech.', image: shubhamMeshram, fit: 'cover', focus: '50%' },
  { name: 'Preeti Godabole', role: 'Specialist – Ethical Hacking, Cybersecurity', description: 'Specialist in Ethical Hacking and Cybersecurity.', image: preetiGodabole, fit: 'cover', focus: '50%' },
  { name: 'Vishwanath Chikareddi', role: 'Specialist – Robotics/Internet of Things', description: 'Specialist in Robotics and Internet of Things.', image: vishwanathChikareddi, fit: 'cover', focus: '45%' },
  { name: 'Sanjiv Sinh', role: 'Advisor – Deep Learning', description: 'Advisor, Deep Learning.', image: sanjivSinh, fit: 'cover', focus: '38%' },
  { name: 'Puja Mishra', role: 'Advisor – Organic Chemistry', description: 'Advisor, Organic Chemistry.', image: pujaMishra, fit: 'cover', focus: '42%' },
  { name: 'Palash Ingle', role: 'Specialist – LiDAR, Deep Learning', description: 'Specialist in LiDAR and Deep Learning.', image: palashIngle, fit: 'cover', focus: '62%' },
  { name: 'Prajwal Khandare', role: 'Specialist – Arduino Programming', description: 'Specialist in Arduino Programming.', image: prajwalKhandare, fit: 'cover', focus: '62%' },
  { name: 'Pradnya Sambary', role: 'Expert – French', description: 'Expert in French.', image: pradnyaSambary, fit: 'cover', focus: '45%' },
  { name: 'Sapna Singh', role: 'Expert – Spoken English', description: 'Expert in Spoken English.', image: sapnaSingh, fit: 'contain', focus: '50%' },
  { name: 'Gaurav Pangam', role: 'Specialist – Full Stack Development', description: 'Specialist in Full Stack Development.', image: gauravPangam, fit: 'cover', focus: '28%' },
  { name: 'Jay Prakash Pathak', role: 'Specialist – Full Stack Development', description: 'Specialist in Full Stack Development.', image: jayPrakashPathak, fit: 'cover', focus: '68%' },
  { name: 'Shreya Sahu', role: 'Expert – Digital Marketing/Tally/Tableau', description: 'Expert in Digital Marketing, Tally and Tableau.', image: shreyaSahu, fit: 'cover', focus: '55%' },
];
---

<Section theme="subtle" id="faculty" class="faculty-compact">
  <Container>
    <p class="kicker" data-reveal>Faculty</p>
    <h2 data-reveal>Learn from practitioners, not just lecturers</h2>

    <div class="faculty-rail-widget" data-faculty-rail data-reveal>
      <div class="rail-row">
        <button type="button" class="rail-arrow" data-prev aria-label="Previous faculty member">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <ul class="rail-track" data-rail-track aria-label="Faculty members">
          {
            faculty.map((f, i) => (
              <li class="rail-item">
                <article class="rail-card">
                  <span class="rail-photo">
                    <Image
                      src={f.image}
                      alt={`${f.name}, ${f.role}`}
                      width={340}
                      loading={i < 3 ? 'eager' : 'lazy'}
                      style={`object-fit: ${f.fit}; object-position: 50% ${f.focus};`}
                    />
                  </span>
                  <div class="rail-info">
                    <h3 class="rail-name">{f.name}</h3>
                    <p class="rail-role">{f.role}</p>
                    <span class="rail-rule" aria-hidden="true" />
                    <p class="rail-description">{f.description}</p>
                  </div>
                </article>
              </li>
            ))
          }
        </ul>

        <button type="button" class="rail-arrow" data-next aria-label="Next faculty member">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>

      <!-- Thin progress line reflecting scroll position along the rail -->
      <div class="progress-line" aria-hidden="true">
        <span class="progress-track" />
        <span class="progress-dot" data-progress-dot />
      </div>
    </div>
  </Container>
</Section>

<style>
  .kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-2);
  }

  h2 {
    max-width: 24ch;
    margin-bottom: var(--space-8);
  }

  /* Reduce this section's own vertical rhythm only — no other section touched */
  :global(.section.faculty-compact) {
    padding-block: var(--space-12);
  }

  .rail-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .rail-arrow {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-primary);
    background: transparent;
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.7;
    transition: var(--transition-fast);
  }

  .rail-arrow:hover {
    background: var(--color-primary);
    color: #fff;
    opacity: 1;
  }

  .rail-track {
    flex: 1;
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .rail-track::-webkit-scrollbar {
    display: none;
  }

  .rail-track:active {
    cursor: grabbing;
  }

  .rail-item {
    flex: 0 0 clamp(240px, 78vw, 300px);
    scroll-snap-align: start;
  }

  .rail-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .rail-photo {
    display: block;
    width: 100%;
    aspect-ratio: 1.85 / 1;
    overflow: hidden;
    background: var(--color-bg-subtle);
    pointer-events: none;
  }

  .rail-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rail-info {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) var(--space-5) var(--space-4);
    min-width: 0;
  }

  .rail-name {
    font-size: var(--text-lg);
    color: var(--color-primary-dark);
    margin-bottom: 2px;
  }

  .rail-role {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-accent-dark);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rail-rule {
    display: block;
    width: 32px;
    height: 2px;
    background: var(--color-golden-subtle);
    margin-block: var(--space-2);
  }

  .rail-description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Progress line */
  .progress-line {
    position: relative;
    width: 100%;
    margin-top: var(--space-6);
    padding-inline: calc(36px + var(--space-3));
  }

  .progress-track {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-border);
  }

  .progress-dot {
    position: absolute;
    top: 50%;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    transform: translate(-50%, -50%);
    transition: left 0.15s linear;
  }

  @media (min-width: 640px) {
    .rail-item {
      flex-basis: 300px;
    }
  }

  /* Laptop/desktop: exactly 3 full cards + a deliberate ~10-15% preview of
     the next one, sized relative to the rail's own visible width so it
     holds steady across viewport sizes rather than leaving a random sliver. */
  @media (min-width: 1024px) {
    .rail-item {
      flex-basis: calc((100% - 2 * var(--space-4)) / 3.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-track {
      scroll-behavior: auto;
    }

    .progress-dot {
      transition: none;
    }
  }
</style>

<script>
  const rails = document.querySelectorAll<HTMLElement>('[data-faculty-rail]');

  rails.forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-rail-track]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const progressDot = root.querySelector<HTMLElement>('[data-progress-dot]');
    if (!track) return;

    let autoplayTimer: ReturnType<typeof setInterval> | null = null;
    const AUTOPLAY_DELAY = 4500;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function step() {
      const first = track!.querySelector<HTMLElement>('.rail-item');
      if (!first) return track!.clientWidth;
      const gap = parseFloat(getComputedStyle(track!).columnGap || getComputedStyle(track!).gap || '0');
      return first.getBoundingClientRect().width + gap;
    }

    function updateProgress() {
      if (!progressDot) return;
      const maxScroll = track!.scrollWidth - track!.clientWidth;
      const ratio = maxScroll > 0 ? track!.scrollLeft / maxScroll : 0;
      progressDot.style.left = `${ratio * 100}%`;
    }

    function advance(direction: 1 | -1) {
      const atStart = track!.scrollLeft <= 4;
      const atEnd = track!.scrollLeft + track!.clientWidth >= track!.scrollWidth - 4;

      if (direction === 1 && atEnd) {
        track!.scrollTo({ left: 0, behavior: 'smooth' });
      } else if (direction === -1 && atStart) {
        track!.scrollTo({ left: track!.scrollWidth, behavior: 'smooth' });
      } else {
        track!.scrollBy({ left: direction * step(), behavior: 'smooth' });
      }
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function startAutoplay() {
      if (prefersReducedMotion) return;
      stopAutoplay();
      autoplayTimer = setInterval(() => advance(1), AUTOPLAY_DELAY);
    }

    prevBtn?.addEventListener('click', () => {
      advance(-1);
      startAutoplay();
    });

    nextBtn?.addEventListener('click', () => {
      advance(1);
      startAutoplay();
    });

    // Pointer-drag scrolling for desktop mouse users (touch/trackpad already
    // scroll natively via overflow-x).
    let isDown = false;
    let startX = 0;
    let startScrollLeft = 0;

    track.addEventListener('pointerdown', (e) => {
      isDown = true;
      startX = e.clientX;
      startScrollLeft = track!.scrollLeft;
      stopAutoplay();
    });

    track.addEventListener('pointermove', (e) => {
      if (!isDown) return;
      const dx = e.clientX - startX;
      track!.scrollLeft = startScrollLeft - dx;
    });

    function endDrag() {
      if (!isDown) return;
      isDown = false;
      startAutoplay();
    }

    window.addEventListener('pointerup', endDrag);
    track.addEventListener('pointerleave', endDrag);

    track.addEventListener('scroll', updateProgress, { passive: true });

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);

    updateProgress();
    startAutoplay();
  });
</script>
