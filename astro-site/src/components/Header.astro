---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Nav from './Nav.astro';
import Button from './Button.astro';
import logo from '../assets/brand/logo-transparent.png';
---

<header class="header" id="main-header">
  <Container class="header__inner">
    <a href="/" class="logo" aria-label="Utkarsh Minds — home">
      <Image
        src={logo}
        alt="Utkarsh Minds"
        height={60}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <Nav />

    <div class="header-actions" id="header-actions">
      <div class="social-icons">
        <a href="https://www.instagram.com/utkarsh_minds_institute/" target="_blank" rel="noopener" aria-label="Utkarsh Minds on Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <a href="https://in.linkedin.com/company/utkarshminds" target="_blank" rel="noopener" aria-label="Utkarsh Minds on LinkedIn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a href="https://facebook.com/profile.php?id=61555480462542" target="_blank" rel="noopener" aria-label="Utkarsh Minds on Facebook">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="https://www.youtube.com/@utkarshminds" target="_blank" rel="noopener" aria-label="Utkarsh Minds on YouTube">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        </a>
      </div>
      <Button href="/login" variant="outline">Login</Button>
      <Button href="/#programs" variant="accent">Enroll Now</Button>
    </div>

    <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    background-color: var(--color-bg);
    z-index: var(--z-header);
    transition: var(--transition-base);
    border-bottom: 1px solid var(--color-border);
  }

  .header.scrolled {
    box-shadow: var(--shadow-md);
  }

  :global(.header__inner) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    min-height: 80px;
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo :global(img) {
    height: 60px;
    width: auto;
    display: block;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .social-icons {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-right: var(--space-2);
    border-right: 1px solid var(--color-border);
  }

  .social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    transition: transform 250ms ease, color 250ms ease;
  }

  .social-icons a:hover,
  .social-icons a:focus-visible {
    color: var(--color-accent);
    transform: scale(1.09);
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: var(--space-2);
    color: var(--color-primary);
    cursor: pointer;
  }

  @media (max-width: 1023px) {
    .header-actions {
      gap: var(--space-3);
    }

    .social-icons {
      gap: var(--space-2);
      padding-right: var(--space-1);
    }
  }

  @media (max-width: 768px) {
    .header-actions {
      display: none;
      flex-direction: column;
      flex-basis: 100%;
      order: 4;
      gap: var(--space-3);
      padding: 0 var(--space-6) var(--space-6);
      background: var(--color-bg);
    }

    .header-actions.active {
      display: flex;
    }

    .menu-toggle {
      display: block;
      order: 2;
    }

    .social-icons {
      justify-content: center;
      padding-right: 0;
      padding-bottom: var(--space-3);
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>

<script>
  const header = document.getElementById('main-header');
  const menuToggle = document.getElementById('menu-toggle');
  const navMenu = document.getElementById('nav-menu');
  const headerActions = document.getElementById('header-actions');

  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 10);
  });

  menuToggle?.addEventListener('click', () => {
    const isOpen = navMenu?.classList.toggle('active');
    headerActions?.classList.toggle('active');
    menuToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
