---
import Container from './Container.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <Container>
    <div class="footer-grid">
      <div class="footer-col">
        <a href="/" class="logo">
          Utkarsh <span>Minds</span>
        </a>
        <p class="footer-blurb">
          Empowering students to achieve their dreams through quality education and expert guidance.
        </p>
        <div class="social-icons">
          <a href="https://www.instagram.com/utkarsh_minds_institute/" target="_blank" rel="noopener" aria-label="Utkarsh Minds on Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="https://in.linkedin.com/company/utkarshminds" target="_blank" rel="noopener" aria-label="Utkarsh Minds on LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href="https://facebook.com/profile.php?id=61555480462542" target="_blank" rel="noopener" aria-label="Utkarsh Minds on Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href="https://www.youtube.com/@utkarshminds" target="_blank" rel="noopener" aria-label="Utkarsh Minds on YouTube">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
          </a>
        </div>
      </div>

      <nav class="footer-col" aria-label="Quick links">
        <h4>Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/about">About Us</a></li>
          <li><a href="/courses">Courses</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <h4>Contact</h4>
        <ul class="footer-links">
          <li><a href="tel:+917718849238">Call: +91 77188 49238</a></li>
          <li><a href="https://wa.me/919619997797">WhatsApp: +91 96199 97797</a></li>
          <li><a href="mailto:pranav.nerurkar@utkarshminds.com">pranav.nerurkar@utkarshminds.com</a></li>
          <li>Sardar Patel Institute of Technology (SPIT), Bhavan's Campus, Munshi Nagar, Andheri (West), Mumbai - 400058, Maharashtra, India</li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Newsletter</h4>
        <p class="footer-blurb">Subscribe to get updates on new courses and offers.</p>
        <form class="newsletter-form">
          <label class="visually-hidden" for="newsletter-email">Email address</label>
          <input id="newsletter-email" type="email" placeholder="Email address" required />
          <button type="submit" class="newsletter-submit" aria-label="Subscribe">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          </button>
        </form>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Utkarsh Minds. All Rights Reserved.</p>
    </div>
  </Container>
</footer>

<style>
  .footer {
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
    padding-block: var(--space-20) var(--space-8);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-16);
  }

  .footer .logo {
    font-size: var(--text-xl);
    font-weight: 800;
    color: #fff;
    display: inline-flex;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .footer .logo span {
    color: var(--color-accent);
  }

  .footer-blurb {
    color: var(--color-dark-text-muted);
    max-width: 280px;
  }

  .social-icons {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .social-icons a {
    color: var(--color-dark-text-muted);
    transition: var(--transition-base);
  }

  .social-icons a:hover {
    color: var(--color-accent);
  }

  .footer-col h4 {
    color: #fff;
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-links a {
    color: var(--color-dark-text-muted);
    transition: var(--transition-base);
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-links li {
    color: var(--color-dark-text-muted);
    font-size: var(--text-sm);
  }

  .newsletter-form {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .newsletter-form input {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    border: none;
    flex: 1;
    min-width: 0;
    font-family: inherit;
  }

  .newsletter-submit {
    padding: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-accent);
    color: var(--color-text);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition-base);
  }

  .newsletter-submit:hover {
    background-color: var(--color-accent-dark);
  }

  .footer-bottom {
    text-align: center;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-dark-border);
    color: var(--color-dark-text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
