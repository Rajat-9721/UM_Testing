---
/**
 * Minimal shell for app screens (login, dashboards) — deliberately
 * skips the marketing Header/Footer/WhatsApp fab. Keeps brand tokens
 * (fonts, colors, spacing) via global.css without marketing chrome.
 */
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Utkarsh Minds</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="app-shell">
    <slot />
  </body>
</html>

<style is:global>
  body.app-shell {
    background: var(--color-bg-subtle);
    min-height: 100vh;
  }
</style>
