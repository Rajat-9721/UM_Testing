---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

interface FAQItem {
  q: string;
  a: string;
}

interface FAQGroup {
  id: string;
  title: string;
  items: FAQItem[];
}

const groups: FAQGroup[] = [
  {
    id: 'overview',
    title: 'Program Overview',
    items: [
      {
        q: 'What is the Professional Certification in Artificial Intelligence and Agentic AI?',
        a: 'The Professional Certification in Artificial Intelligence and Agentic AI is a comprehensive, hands-on program designed to help learners build practical skills in modern Artificial Intelligence. The program covers Python Programming, Statistics in Python, Machine Learning, Deep Learning, Natural Language Processing, Generative AI + Agentic AI, Computer Vision, Power BI, Big Data and career preparation.',
      },
      {
        q: 'Who is this AI certification course designed for?',
        a: 'The program is suitable for students pursuing graduation, diploma holders, graduates, postgraduates and PGDM students, PhD scholars, working professionals and learners who want to build practical AI skills.',
      },
      {
        q: 'Can students who are currently pursuing graduation join the course?',
        a: 'Yes. Students currently pursuing graduation can enroll in the program.',
      },
      {
        q: 'Do I need prior programming or AI knowledge?',
        a: 'No. Prior programming knowledge is not required. Basic computer knowledge is sufficient. The program starts with Python and progressively builds the skills required for Artificial Intelligence.',
      },
      {
        q: 'Is this course suitable for beginners?',
        a: 'Yes. The learning path progresses from Python and statistics to Machine Learning, Deep Learning, NLP, Generative AI + Agentic AI and other AI technologies.',
      },
      {
        q: 'Is the course useful for working professionals?',
        a: 'Yes. The Saturday and Sunday schedule, from 9:00 AM to 1:00 PM, is designed to be convenient for working professionals.',
      },
      {
        q: 'Is the course useful for students?',
        a: 'Yes. The program can complement academic education with practical exposure to AI technologies, projects and career preparation.',
      },
      {
        q: 'What makes this course different from a typical online AI course?',
        a: 'The program combines structured classroom learning, hands-on implementation, projects, modern Generative AI + Agentic AI, career preparation, internship and placement assistance through SPIT.',
      },
      {
        q: 'What is Utkarsh Minds Technologies?',
        a: 'Utkarsh Minds Technologies partners with leading enterprises and top-tier academic institutions to co-create industry-relevant learning experiences that drive high-impact outcomes.',
      },
    ],
  },
  {
    id: 'curriculum',
    title: 'Curriculum & Agentic AI',
    items: [
      {
        q: 'What topics are covered in the course?',
        a: 'The program covers Python Programming, Statistics in Python, Machine Learning, Deep Learning, Natural Language Processing, Generative AI + Agentic AI, Computer Vision, Power BI, Big Data, and Interview Preparation + Resume Building + Soft Skills Training.',
      },
      {
        q: 'Does the course include Machine Learning?',
        a: 'Yes. Machine Learning is a major component of the program, with practical learning focused on applying ML concepts to datasets and problems.',
      },
      {
        q: 'Does the course include Deep Learning?',
        a: 'Yes. Deep Learning is included as a dedicated component of the program, with practical applications involving neural networks and model development.',
      },
      {
        q: 'Does the course include Generative AI + Agentic AI?',
        a: 'Yes. Generative AI + Agentic AI is a dedicated 25-hour component of the 200-hour program.',
      },
      {
        q: 'What topics are covered under Agentic AI?',
        a: 'The dedicated Agentic AI component covers AI Agents and Agentic Workflows, LLM-based Agents, Tool Calling, Function Calling, Planning and Reasoning, Memory, Multi-Agent Systems, Retrieval-Augmented Generation (RAG), Agent Orchestration, Building Practical AI Agents, and Agent Evaluation and Responsible AI.',
      },
      {
        q: 'What is Agentic AI and why is it included in the course?',
        a: "Agentic AI focuses on AI systems that can work toward goals through reasoning, planning, tool use and coordinated actions. It extends the learner's understanding beyond conventional AI applications toward practical AI-agent workflows.",
      },
      {
        q: 'Does the course include Natural Language Processing?',
        a: 'Yes. Natural Language Processing is included in the curriculum, with practical work involving text processing and text-based AI applications.',
      },
      {
        q: 'Does the course include Computer Vision?',
        a: 'Yes. Computer Vision is covered through practical image-based AI applications.',
      },
      {
        q: 'Is Statistics included in the course?',
        a: 'Yes. Statistics in Python is a dedicated 20-hour component and supports data analysis, statistical reasoning and Machine Learning.',
      },
      {
        q: 'Is Python taught from the basics?',
        a: 'Yes. Python is taught as a foundation for the subsequent AI and Machine Learning modules.',
      },
      {
        q: 'Is the course theoretical or practical?',
        a: 'The program is designed as hands-on classroom training, with practical exercises, assignments and projects supporting the concepts taught.',
      },
      {
        q: 'Will I work on real-world projects?',
        a: 'Yes. The program includes practical and industry-oriented projects and case studies across AI and related areas.',
      },
      {
        q: 'Will I learn how to build AI applications?',
        a: 'Yes. The program emphasizes implementation and application of AI concepts through programming, datasets, Machine Learning, Deep Learning, NLP, Computer Vision, Generative AI and Agentic AI.',
      },
      {
        q: 'Does the course include AI model or application deployment?',
        a: 'Deployment-oriented practical learning is included in the program where applicable to the AI application modules.',
      },
    ],
  },
  {
    id: 'schedule',
    title: 'Schedule, Format & Learning Experience',
    items: [
      {
        q: 'What is the duration of the course?',
        a: 'The total course duration is 200 hours.',
      },
      {
        q: 'What are the class timings?',
