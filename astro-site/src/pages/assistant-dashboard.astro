---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Button from '../components/Button.astro';
import spitLogoUrl from '../assets/brand/spit-logo.png?url';

const menu = [
  { label: 'Student Management', target: 'student-management' },
  { label: 'Fee Receipts', target: 'fee-receipts' },
  { label: 'Programs', target: 'programs' },
  { label: 'Team', target: 'team' },
  { label: 'LinkedIn Post Generator', target: 'linkedin-post' },
];
const comingSoon = ['Leads', 'Communication Tools', 'Analytics'];
---

<DashboardLayout title="Assistant Dashboard" portalLabel="Assistant Portal" menu={menu} comingSoon={comingSoon}>
  <div class="dash-header">
    <h1>Assistant Dashboard</h1>
  </div>

  <section class="dash-panel active" id="student-management">
    <div class="toolbar">
      <input type="text" id="studentSearch" class="search-input" placeholder="Search by name, student ID or email..." />
      <Button variant="accent" id="openAddStudentBtn">+ Add Student</Button>
    </div>

    <table class="data-table" id="studentsTable">
      <thead>
        <tr>
          <th>Student ID</th>
          <th>Name</th>
          <th>Program</th>
          <th>Total Fee</th>
          <th>Paid</th>
          <th>Balance</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="studentsTableBody">
        <tr><td colspan="8" class="empty-state">Loading students...</td></tr>
      </tbody>
    </table>
  </section>

  <section class="dash-panel" id="fee-receipts">
    <div class="toolbar">
      <input type="text" id="receiptSearch" class="search-input" placeholder="Search by receipt number, student name, PRN or email..." />
      <Button variant="accent" id="openGenerateReceiptBtn">+ Generate Fee Receipt</Button>
    </div>

    <table class="data-table" id="receiptsTable">
      <thead>
        <tr>
          <th>Receipt No.</th>
          <th>Receipt Date</th>
          <th>Student Name</th>
          <th>PRN</th>
          <th>Course</th>
          <th>Amount</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="receiptsTableBody">
        <tr><td colspan="7" class="empty-state">Loading receipts...</td></tr>
      </tbody>
    </table>
  </section>

  <section class="dash-panel" id="programs">
    <div class="toolbar">
      <p class="dash-muted" style="margin:0;">Programs shown here are what appears in the "Program / Course" picker when registering a student.</p>
      <Button variant="accent" id="openAddProgramBtn">+ Add Program</Button>
    </div>

    <table class="data-table" id="programsTable">
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Price</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="programsTableBody">
        <tr><td colspan="5" class="empty-state">Loading programs...</td></tr>
      </tbody>
    </table>
  </section>

  <section class="dash-panel" id="team">
    <div class="toolbar">
      <p class="dash-muted" style="margin:0;">Everyone listed here has full assistant access — student records, payments and program management.</p>
      <Button variant="accent" id="openAddAssistantBtn">+ Add Assistant</Button>
    </div>

    <table class="data-table" id="assistantsTable">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Added On</th>
        </tr>
      </thead>
      <tbody id="assistantsTableBody">
        <tr><td colspan="4" class="empty-state">Loading team...</td></tr>
      </tbody>
    </table>
  </section>

  <section class="dash-panel" id="linkedin-post">
    <h2>LinkedIn Post Generator</h2>
    <p class="dash-muted" style="margin-bottom: 1.25rem;">
      This is a placeholder tool for drafting announcement text. It is not connected to LinkedIn
      and does not use AI generation — a real content-generation module is a future module.
    </p>
    <form id="linkedinPostForm">
      <div class="form-group">
        <label for="postTopic">Topic / Key Points</label>
        <textarea id="postTopic" rows="4" required placeholder="e.g., New course launch for Python programming..."></textarea>
      </div>
      <Button type="submit" variant="accent">Generate Draft Text</Button>
    </form>
    <div id="generatedPost" style="margin-top: 20px; padding: 20px; background: var(--color-bg-subtle); border-radius: 8px; white-space: pre-wrap; display: none;"></div>
  </section>

  <Fragment slot="modals">
    <!-- Add Student Modal -->
    <div class="modal-backdrop" id="addStudentModal">
      <div class="modal">
        <div class="modal-header">
          <h2>Register New Student</h2>
          <button class="modal-close" data-close="addStudentModal">&times;</button>
        </div>
        <div id="student-alert" class="alert"></div>
        <form id="createStudentForm">
          <div class="form-row">
            <div class="form-group">
              <label for="studentFullName">Full Name</label>
              <input type="text" id="studentFullName" required />
            </div>
            <div class="form-group">
              <label for="studentPhone">Registered Mobile Number</label>
              <input type="tel" id="studentPhone" required placeholder="+91 XXXXX XXXXX" />
            </div>
          </div>
          <div class="form-group">
            <label for="studentEmail">Student Email</label>
            <input type="email" id="studentEmail" required />
          </div>
          <div class="form-group">
            <label for="studentPassword">Temporary Password</label>
            <input type="password" id="studentPassword" required minlength="6" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="studentCourse">Program / Course</label>
              <select id="studentCourse" required></select>
            </div>
            <div class="form-group">
              <label for="studentTotalFee">Total Program Fee (₹)</label>
              <input type="number" id="studentTotalFee" min="0" step="0.01" required />
            </div>
          </div>
          <Button type="submit" variant="accent" id="createStudentBtn">Create Student</Button>
        </form>
      </div>
    </div>

    <!-- View Student Modal -->
    <div class="modal-backdrop" id="viewStudentModal">
      <div class="modal modal-wide">
        <div class="modal-header">
          <h2 id="viewStudentName">Student Details</h2>
          <button class="modal-close" data-close="viewStudentModal">&times;</button>
        </div>
        <div id="viewStudentBody">Loading...</div>
      </div>
    </div>

    <!-- Record Payment Modal -->
    <div class="modal-backdrop" id="recordPaymentModal">
      <div class="modal">
        <div class="modal-header">
          <h2>Record Payment</h2>
          <button class="modal-close" data-close="recordPaymentModal">&times;</button>
        </div>
        <div id="payment-alert" class="alert"></div>
        <form id="recordPaymentForm">
          <input type="hidden" id="paymentEnrollmentId" />
          <div class="form-row">
            <div class="form-group">
              <label for="paymentAmount">Amount (₹)</label>
              <input type="number" id="paymentAmount" min="0.01" step="0.01" required />
            </div>
            <div class="form-group">
              <label for="paymentDate">Payment Date</label>
              <input type="date" id="paymentDate" required />
            </div>
          </div>
          <div class="form-group">
            <label for="paymentMethod">Payment Method</label>
            <select id="paymentMethod" required>
              <option value="cash">Cash</option>
              <option value="upi">UPI</option>
              <option value="netbanking">Net Banking</option>
              <option value="bank_transfer">Bank Transfer</option>
              <option value="cheque">Cheque</option>
            </select>
          </div>

          <div class="method-fields" data-method="upi,netbanking,bank_transfer">
            <div class="form-group">
              <label for="paymentReference">Transaction / UTR / Reference ID</label>
              <input type="text" id="paymentReference" />
            </div>
          </div>

          <div class="method-fields" data-method="cheque">
            <div class="form-row">
              <div class="form-group">
                <label for="chequeNumber">Cheque Number</label>
                <input type="text" id="chequeNumber" />
              </div>
              <div class="form-group">
                <label for="chequeBank">Bank Name</label>
                <input type="text" id="chequeBank" />
              </div>
            </div>
            <div class="form-group">
              <label for="chequeDate">Cheque Date</label>
              <input type="date" id="chequeDate" />
            </div>
          </div>

          <div class="form-group">
            <label for="paymentNote">Internal Note (optional)</label>
            <textarea id="paymentNote" rows="2"></textarea>
          </div>

          <Button type="submit" variant="accent" id="recordPaymentBtn">Record Payment</Button>
        </form>
      </div>
    </div>

    <!-- Manage Enrollment Modal -->
    <div class="modal-backdrop" id="manageEnrollmentModal">
      <div class="modal">
        <div class="modal-header">
          <h2 id="manageEnrollmentTitle">Manage Enrollment</h2>
          <button class="modal-close" data-close="manageEnrollmentModal">&times;</button>
        </div>
        <div id="enrollment-alert" class="alert"></div>
        <form id="manageEnrollmentForm">
          <input type="hidden" id="enrollmentId" />
          <input type="hidden" id="enrollmentStudentId" />
          <div class="form-group">
            <label for="enrollmentCourse">Program / Course</label>
            <select id="enrollmentCourse" required></select>
          </div>
          <div class="form-group">
            <label for="enrollmentTotalFee">Total Program Fee (₹)</label>
            <input type="number" id="enrollmentTotalFee" min="0" step="0.01" required />
          </div>
          <Button type="submit" variant="accent">Save Changes</Button>
        </form>
      </div>
    </div>

    <!-- Add / Edit Program Modal -->
    <div class="modal-backdrop" id="programModal">
      <div class="modal">
        <div class="modal-header">
          <h2 id="programModalTitle">Add Program</h2>
          <button class="modal-close" data-close="programModal">&times;</button>
        </div>
        <div id="program-alert" class="alert"></div>
        <form id="programForm">
          <input type="hidden" id="programId" />
          <div class="form-group">
            <label for="programTitle">Title</label>
            <input type="text" id="programTitle" required />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="programCategory">Category</label>
              <input type="text" id="programCategory" required placeholder="e.g., ai, datascience, foundation" />
            </div>
            <div class="form-group">
              <label for="programPrice">Price (₹, optional)</label>
              <input type="number" id="programPrice" min="0" step="0.01" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="programFaculty">Faculty (optional)</label>
              <input type="text" id="programFaculty" />
            </div>
            <div class="form-group">
              <label for="programMode">Mode (optional)</label>
              <input type="text" id="programMode" placeholder="e.g., Online/Offline" />
            </div>
          </div>
          <div class="form-group">
            <label for="programBadge">Badge (optional)</label>
            <input type="text" id="programBadge" placeholder="e.g., Most Popular" />
          </div>
          <div class="form-group">
            <label for="programDescription">Description (optional)</label>
            <textarea id="programDescription" rows="3"></textarea>
          </div>
          <Button type="submit" variant="accent" id="saveProgramBtn">Save Program</Button>
        </form>
      </div>
    </div>

    <!-- Add Assistant Modal -->
    <div class="modal-backdrop" id="addAssistantModal">
      <div class="modal">
        <div class="modal-header">
          <h2>Add Assistant</h2>
          <button class="modal-close" data-close="addAssistantModal">&times;</button>
        </div>
        <p class="dash-muted" style="margin-bottom: 1rem;">This grants full assistant access — student records, payments and program management.</p>
        <div id="assistant-alert" class="alert"></div>
        <form id="createAssistantForm">
          <div class="form-row">
            <div class="form-group">
              <label for="assistantFullName">Full Name</label>
              <input type="text" id="assistantFullName" required />
            </div>
            <div class="form-group">
              <label for="assistantPhone">Mobile Number</label>
              <input type="tel" id="assistantPhone" required placeholder="+91 XXXXX XXXXX" />
            </div>
          </div>
          <div class="form-group">
            <label for="assistantEmail">Email</label>
            <input type="email" id="assistantEmail" required />
          </div>
          <div class="form-group">
            <label for="assistantPassword">Temporary Password</label>
            <input type="password" id="assistantPassword" required minlength="6" />
          </div>
          <Button type="submit" variant="accent" id="createAssistantBtn">Create Assistant</Button>
        </form>
      </div>
    </div>

    <!-- Generate Fee Receipt Modal -->
    <div class="modal-backdrop" id="generateReceiptModal">
      <div class="modal modal-xwide">
        <div class="modal-header">
          <h2 id="generateReceiptTitle">Generate Fee Receipt</h2>
          <button class="modal-close" data-close="generateReceiptModal">&times;</button>
        </div>

        <div class="receipt-modal-body" id="generateReceiptFormWrap">
          <form id="generateReceiptForm">
            <div class="form-group">
              <label for="receiptStudentInput">Student</label>
              <input type="text" id="receiptStudentInput" list="receiptStudentList" required autocomplete="off" placeholder="Search by name, PRN or email..." />
              <datalist id="receiptStudentList"></datalist>
            </div>

            <div class="form-group">
              <label for="receiptCourseDisplay">Course (from student's current enrollment)</label>
              <input type="text" id="receiptCourseDisplay" disabled placeholder="Select a student first" />
            </div>

            <div class="form-group">
              <label for="receiptDate">Payment / Receipt Date</label>
              <input type="date" id="receiptDate" required />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="receiptAcademicYear">Academic Year</label>
                <input type="text" id="receiptAcademicYear" />
              </div>
              <div class="form-group">
                <label for="receiptFinancialYear">Financial Year</label>
                <input type="text" id="receiptFinancialYear" />
              </div>
            </div>

            <div class="form-group">
              <label for="receiptPaymentMethod">Payment Method</label>
              <select id="receiptPaymentMethod" required>
                <option value="cash">Cash</option>
                <option value="upi">UPI</option>
                <option value="netbanking">Net Banking</option>
                <option value="bank_transfer">Bank Transfer</option>
                <option value="cheque">Cheque</option>
              </select>
            </div>

            <div class="receipt-method-fields" data-method="upi,netbanking,bank_transfer">
              <div class="form-group">
                <label for="receiptReference">Transaction / UTR / Reference ID</label>
                <input type="text" id="receiptReference" />
              </div>
            </div>

            <div class="receipt-method-fields" data-method="cheque">
              <div class="form-row">
                <div class="form-group">
                  <label for="receiptChequeNumber">Cheque Number</label>
                  <input type="text" id="receiptChequeNumber" />
                </div>
                <div class="form-group">
                  <label for="receiptChequeBank">Bank Name</label>
                  <input type="text" id="receiptChequeBank" />
                </div>
              </div>
              <div class="form-group">
                <label for="receiptChequeDate">Cheque Date</label>
                <input type="date" id="receiptChequeDate" />
              </div>
            </div>

            <div class="form-group">
              <label>Particulars of Fees</label>
              <div id="feeParticularsRows"></div>
              <button type="button" class="fp-add-btn" id="addFeeParticularBtn">+ Add Line Item</button>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Total</label>
                <input type="text" id="receiptTotalDisplay" disabled />
              </div>
              <div class="form-group">
                <label>Amount in Words</label>
                <input type="text" id="receiptWordsDisplay" disabled />
              </div>
            </div>

            <div id="receipt-alert" class="alert"></div>

            <Button type="submit" variant="accent" id="generateReceiptBtn">Generate Receipt</Button>
          </form>

          <div class="receipt-preview" id="receiptPreview" aria-hidden="true">
            <div class="rp-header">
              <div class="rp-logo"><img src={spitLogoUrl} alt="SPIT" /></div>
              <div class="rp-institute">
                <p class="rp-bhavan">Bharatiya Vidhya Bhavan's</p>
                <p class="rp-institute-name">Sardar Patel Institute of Technology</p>
                <p class="rp-address">Munshi Nagar, Andheri (West), Mumbai 400 058</p>
              </div>
            </div>
            <div class="rp-banner">PAYMENT RECEIPT</div>
            <div class="rp-fields">
              <div class="rp-col">
                <div class="rp-field"><span>Receipt No.</span><span id="rpReceiptNo">—</span></div>
                <div class="rp-field"><span>Student Name</span><span id="rpStudentName">—</span></div>
                <div class="rp-field"><span>Email Id</span><span id="rpEmail">—</span></div>
                <div class="rp-field"><span>Academic Year</span><span id="rpAcademicYear">—</span></div>
              </div>
              <div class="rp-col">
                <div class="rp-field"><span>Receipt Date</span><span id="rpDate">—</span></div>
                <div class="rp-field"><span>Roll No. (UID)</span><span id="rpRollNoUid">—</span></div>
                <div class="rp-field"><span>Financial Year</span><span id="rpFinancialYear">—</span></div>
                <div class="rp-field"><span>Mobile</span><span id="rpMobile">—</span></div>
                <div class="rp-field"><span>Payment Mode</span><span id="rpPaymentMode">—</span></div>
                <div class="rp-field"><span>Transaction ID</span><span id="rpTransactionId">—</span></div>
              </div>
            </div>
            <div class="rp-field rp-field-full"><span>Program Name</span><span id="rpProgram">—</span></div>
            <table class="rp-table">
              <thead><tr><th>Sr.No</th><th>Particulars of the Fees</th><th>Amount (Rs.)</th></tr></thead>
              <tbody id="rpParticularsBody"></tbody>
              <tfoot><tr><td colspan="2">Total:</td><td id="rpTotal">0.00</td></tr></tfoot>
            </table>
            <p class="rp-words">Amount in Words : <span id="rpWords">—</span></p>
            <p class="rp-disclaimer">*This is a computer generated receipt and does not require signature or stamp.</p>
          </div>
        </div>

        <div class="receipt-success" id="receiptSuccessPanel" hidden>
          <p class="alert alert-success" style="display:block;">Fee Receipt Generated Successfully</p>
          <div class="profile-row"><span class="label">Receipt No.</span><span class="value" id="successReceiptNo"></span></div>
          <div class="profile-row"><span class="label">Student Name</span><span class="value" id="successStudentName"></span></div>
          <div class="profile-row"><span class="label">Course</span><span class="value" id="successCourse"></span></div>
          <div class="profile-row"><span class="label">Amount</span><span class="value" id="successAmount"></span></div>
          <div class="receipt-success-actions">
            <button type="button" id="successViewBtn">View Receipt</button>
            <button type="button" id="successDownloadBtn">Download PDF</button>
            <button type="button" id="successPrintBtn">Print Receipt</button>
            <button type="button" id="successBackBtn">Back to Fee Receipts</button>
          </div>
        </div>
      </div>
    </div>
  </Fragment>
</DashboardLayout>

<script>
  import { supabase, requireRole, createEphemeralClient } from '../lib/supabase';
  import { downloadReceipt, viewReceipt, printReceipt } from '../lib/receipt';
  import { amountToWords } from '../lib/numberToWords';

  async function init() {
    const result = await requireRole('assistant');
    if (!result) return;
    await loadCourseOptions();
    await loadStudents();
    await loadPrograms();
    await loadAssistants();
    await loadReceipts();
  }

  function openModal(id: string) { document.getElementById(id)?.classList.add('active'); }
  function closeModal(id: string) { document.getElementById(id)?.classList.remove('active'); }

  // Active-only course list, used by the two enrollment-facing dropdowns
  // (Add Student, Manage Enrollment). Archived programs still show up
  // fine everywhere else because past enrollments reference the course
  // row directly, regardless of is_active.
  async function loadCourseOptions() {
    const { data, error } = await supabase.from('courses').select('id, title').eq('is_active', true).order('title');
    const activeCourses = data || [];
    const selects = [document.getElementById('studentCourse') as HTMLSelectElement, document.getElementById('enrollmentCourse') as HTMLSelectElement];
    selects.forEach((select) => {
      select.innerHTML = activeCourses.length
        ? activeCourses.map((c) => `<option value="${c.id}">${c.title}</option>`).join('')
        : '<option value="">No active programs available</option>';
    });
    if (error) console.error('Failed to load courses:', error);
  }

  let studentsCache: any[] = [];

  function formatCurrency(n: number) {
    return '₹' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function statusLabel(status: string) {
    return ({ UNPAID: 'Unpaid', PARTIALLY_PAID: 'Partially Paid', PAID: 'Paid' } as Record<string, string>)[status] || status;
  }

  function renderStudentsTable(rows: any[]) {
    const body = document.getElementById('studentsTableBody')!;
    if (!rows.length) {
      body.innerHTML = '<tr><td colspan="8" class="empty-state">No students found.</td></tr>';
      return;
    }
    body.innerHTML = rows.map((r) => `
      <tr>
        <td>${r.student_id || '—'}</td>
        <td>${r.full_name || '—'}</td>
        <td>${r.program || 'No program assigned'}</td>
        <td>${formatCurrency(r.total_fee)}</td>
        <td>${formatCurrency(r.total_paid)}</td>
        <td>${formatCurrency(r.balance)}</td>
        <td><span class="status-pill status-${r.status}">${statusLabel(r.status)}</span></td>
        <td class="row-actions">
          <button data-action="view" data-id="${r.profile_id}">View</button>
          ${r.enrollment_id ? `
            <button data-action="pay" data-enrollment="${r.enrollment_id}">Record Payment</button>
            <button data-action="enroll" data-enrollment="${r.enrollment_id}" data-course="${r.course_id || ''}" data-fee="${r.total_fee}">Manage Enrollment</button>
          ` : `
            <button data-action="assign" data-student="${r.profile_id}">Assign Program</button>
          `}
        </td>
      </tr>
    `).join('');
  }

  async function loadStudents() {
    const { data, error } = await supabase
      .from('assistant_student_overview')
      .select('*')
      .order('student_id', { ascending: false });

    if (error) {
      console.error('Failed to load students:', error);
      document.getElementById('studentsTableBody')!.innerHTML =
        `<tr><td colspan="8" class="empty-state">Failed to load students: ${error.message}</td></tr>`;
      return;
    }
    studentsCache = data || [];
    renderStudentsTable(studentsCache);
  }

  document.getElementById('studentSearch')!.addEventListener('input', (e) => {
    const term = (e.target as HTMLInputElement).value.trim().toLowerCase();
    if (!term) { renderStudentsTable(studentsCache); return; }
    const filtered = studentsCache.filter((r) =>
      (r.full_name || '').toLowerCase().includes(term) ||
      (r.student_id || '').toLowerCase().includes(term) ||
      (r.email || '').toLowerCase().includes(term) ||
      (r.program || '').toLowerCase().includes(term)
    );
    renderStudentsTable(filtered);
  });

  document.getElementById('studentsTableBody')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.dataset.action;
    if (action === 'view') openViewStudent(btn.dataset.id as string);
    if (action === 'pay') openRecordPayment(btn.dataset.enrollment as string);
    if (action === 'enroll') openManageEnrollment(btn.dataset.enrollment as string, btn.dataset.course as string, btn.dataset.fee as string);
    if (action === 'assign') openAssignEnrollment(btn.dataset.student as string);
  });

  document.getElementById('openAddStudentBtn')!.addEventListener('click', () => openModal('addStudentModal'));

  // Secondary client so the assistant's own session isn't replaced by the new user's session
  const supabaseSignup = createEphemeralClient();

  document.getElementById('createStudentForm')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fullName = (document.getElementById('studentFullName') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('studentPhone') as HTMLInputElement).value.trim();
    const email = (document.getElementById('studentEmail') as HTMLInputElement).value.trim();
    const password = (document.getElementById('studentPassword') as HTMLInputElement).value;
    const courseId = (document.getElementById('studentCourse') as HTMLSelectElement).value;
    const totalFee = parseFloat((document.getElementById('studentTotalFee') as HTMLInputElement).value);
    const btn = document.getElementById('createStudentBtn') as HTMLButtonElement;
    const alertBox = document.getElementById('student-alert')!;

    btn.disabled = true;
    btn.textContent = 'Creating...';
    alertBox.style.display = 'none';

    try {
      const { data, error } = await supabaseSignup.auth.signUp({ email, password });
      if (error || !data || !data.user) {
        throw new Error(error ? error.message : 'Supabase did not return a new user.');
      }

      const { error: rpcError } = await supabase.rpc('register_student_full', {
        p_user_id: data.user.id,
        p_email: email,
        p_full_name: fullName,
        p_phone: phone,
        p_course_id: courseId || null,
        p_total_fee: totalFee,
      });

      if (rpcError) throw new Error(rpcError.message);

      alertBox.className = 'alert alert-success';
      alertBox.textContent = 'Student created successfully.';
      alertBox.style.display = 'block';
      (e.target as HTMLFormElement).reset();
      await loadStudents();
      setTimeout(() => closeModal('addStudentModal'), 1200);
    } catch (err) {
      alertBox.className = 'alert alert-error';
      alertBox.textContent = (err as Error).message;
      alertBox.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Create Student';
    }
  });

  async function openViewStudent(profileId: string) {
    openModal('viewStudentModal');
    const nameEl = document.getElementById('viewStudentName')!;
    const bodyEl = document.getElementById('viewStudentBody')!;
    bodyEl.innerHTML = 'Loading...';

    const student = studentsCache.find((s) => s.profile_id === profileId);
    nameEl.textContent = student ? student.full_name : 'Student Details';

    const { data: payments, error } = await supabase
      .from('payment_receipts')
      .select('*')
      .eq('student_id', profileId)
      .order('created_at', { ascending: true });

    if (error) {
      bodyEl.innerHTML = `<p class="empty-state">Failed to load payment history: ${error.message}</p>`;
      return;
    }

    const summaryHtml = student ? `
      <div class="summary-grid">
        <div class="summary-tile"><div class="value">${formatCurrency(student.total_fee)}</div><div class="label">Total Fee</div></div>
        <div class="summary-tile"><div class="value">${formatCurrency(student.total_paid)}</div><div class="label">Paid</div></div>
        <div class="summary-tile"><div class="value">${formatCurrency(student.balance)}</div><div class="label">Balance</div></div>
        <div class="summary-tile"><div class="value">${statusLabel(student.status)}</div><div class="label">Status</div></div>
      </div>
      <p class="dash-muted">
        <strong>Student ID:</strong> ${student.student_id || '—'} &middot;
        <strong>Email:</strong> ${student.email || '—'} &middot;
        <strong>Phone:</strong> ${student.phone || '—'} &middot;
        <strong>Program:</strong> ${student.program || '—'}
      </p>
    ` : '';

    const historyHtml = payments && payments.length
      ? `<table class="data-table">
          <thead><tr><th>Date</th><th>Amount</th><th>Method</th><th>Receipt #</th><th>Status After</th></tr></thead>
          <tbody>
            ${payments.map((p: any) => `
              <tr>
                <td>${p.payment_date}</td>
                <td>${formatCurrency(p.amount)}</td>
                <td>${p.payment_method}</td>
                <td>${p.receipt_number}</td>
                <td>${statusLabel(p.status_after_payment)}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>`
      : '<p class="empty-state">No payments recorded yet.</p>';

    bodyEl.innerHTML = `<h3 style="margin-bottom:8px;">Fee Summary</h3>${summaryHtml}<h3 style="margin:20px 0 8px;">Payment History</h3>${historyHtml}`;
  }

