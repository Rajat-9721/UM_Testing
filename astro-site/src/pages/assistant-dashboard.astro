  // ---- Generate Fee Receipt ----
  let selectedReceiptStudent: any = null;
  const studentOptionMap = new Map<string, any>();

  function studentOptionLabel(s: any) {
    return `${s.full_name || 'Unnamed'} (${s.student_id || 'no ID'}) — ${s.email || 'no email'}`;
  }

  function populateStudentDatalist() {
    const datalist = document.getElementById('receiptStudentList') as HTMLDataListElement;
    studentOptionMap.clear();
    datalist.innerHTML = studentsCache.map((s) => {
      const label = studentOptionLabel(s);
