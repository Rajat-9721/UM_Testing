  function resetGenerateReceiptForm() {
    (document.getElementById('generateReceiptForm') as HTMLFormElement).reset();
    selectedReceiptStudent = null;
    (document.getElementById('receiptCourseDisplay') as HTMLInputElement).value = '';
    (document.getElementById('receiptDate') as HTMLInputElement).valueAsDate = new Date();
    const todayStr = new Date().toISOString().slice(0, 10);
    (document.getElementById('receiptAcademicYear') as HTMLInputElement).value = financialYearFor(todayStr);
    (document.getElementById('receiptFinancialYear') as HTMLInputElement).value = financialYearFor(todayStr);
    document.getElementById('receipt-alert')!.style.display = 'none';
    document.getElementById('feeParticularsRows')!.innerHTML = '';
    addFeeParticularRow('Tuition Fees', '');
    updateReceiptMethodFields();
    recalcReceiptTotal();
  }

  function addFeeParticularRow(particular: string, amount: string | number) {
    const wrap = document.getElementById('feeParticularsRows')!;
    if (wrap.children.length >= 5) return;
    const row = document.createElement('div');
    row.className = 'fp-particular-row';
    row.innerHTML = `
      <input type="text" class="fp-particular" value="${particular}" placeholder="Particular" />
      <input type="number" class="fp-amount" min="0" step="0.01" value="${amount}" placeholder="Amount" />
      <button type="button" class="fp-remove" aria-label="Remove line item">&times;</button>
    `;
    wrap.appendChild(row);
    row.querySelector('.fp-particular')!.addEventListener('input', () => { recalcReceiptTotal(); updateReceiptPreview(); });
    row.querySelector('.fp-amount')!.addEventListener('input', () => { recalcReceiptTotal(); updateReceiptPreview(); });
    row.querySelector('.fp-remove')!.addEventListener('click', () => {
      if (wrap.children.length <= 1) return;
      row.remove();
      recalcReceiptTotal();
      updateReceiptPreview();
    });
  }

  document.getElementById('addFeeParticularBtn')!.addEventListener('click', () => {
    addFeeParticularRow('', '');
    updateReceiptPreview();
  });

  function getFeeParticulars(): { particular: string; amount: number }[] {
    return Array.from(document.querySelectorAll('#feeParticularsRows .fp-particular-row')).map((row) => ({
      particular: (row.querySelector('.fp-particular') as HTMLInputElement).value.trim() || 'Fees',
      amount: parseFloat((row.querySelector('.fp-amount') as HTMLInputElement).value) || 0,
    })).filter((p) => p.amount > 0);
  }

  function recalcReceiptTotal() {
    const total = getFeeParticulars().reduce((sum, p) => sum + p.amount, 0);
    (document.getElementById('receiptTotalDisplay') as HTMLInputElement).value = formatCurrency(total);
    (document.getElementById('receiptWordsDisplay') as HTMLInputElement).value = total > 0 ? amountToWords(total) : '';
    return total;
  }

  function updateReceiptMethodFields() {
    const method = (document.getElementById('receiptPaymentMethod') as HTMLSelectElement).value;
    document.querySelectorAll<HTMLElement>('.receipt-method-fields').forEach((block) => {
      const methods = (block.dataset.method as string).split(',');
      block.classList.toggle('active', methods.includes(method));
    });
  }
  document.getElementById('receiptPaymentMethod')!.addEventListener('change', updateReceiptMethodFields);

  function receiptMethodLabel(method: string) {
    return ({ cash: 'Cash', upi: 'UPI', netbanking: 'Net Banking', bank_transfer: 'Bank Transfer', cheque: 'Cheque' } as Record<string, string>)[method] || method;
  }

  function updateReceiptPreview() {
    const total = recalcReceiptTotal();
    const particulars = getFeeParticulars();

    document.getElementById('rpStudentName')!.textContent = selectedReceiptStudent?.full_name || '—';
    document.getElementById('rpEmail')!.textContent = selectedReceiptStudent?.email || '—';
    document.getElementById('rpRollNoUid')!.textContent = selectedReceiptStudent?.student_id || '—';
    document.getElementById('rpProgram')!.textContent = (document.getElementById('receiptCourseDisplay') as HTMLInputElement).value || '—';
    document.getElementById('rpMobile')!.textContent = selectedReceiptStudent?.phone || '—';

    const dateVal = (document.getElementById('receiptDate') as HTMLInputElement).value;
    document.getElementById('rpDate')!.textContent = dateVal ? formatDateDisplay(dateVal) : '—';
    document.getElementById('rpAcademicYear')!.textContent = (document.getElementById('receiptAcademicYear') as HTMLInputElement).value || '—';
    document.getElementById('rpFinancialYear')!.textContent = (document.getElementById('receiptFinancialYear') as HTMLInputElement).value || '—';
    document.getElementById('rpReceiptNo')!.textContent = 'Assigned on generation';

    const method = (document.getElementById('receiptPaymentMethod') as HTMLSelectElement).value;
    document.getElementById('rpPaymentMode')!.textContent = receiptMethodLabel(method);
    const txnId = method === 'cheque'
      ? (document.getElementById('receiptChequeNumber') as HTMLInputElement).value
      : (document.getElementById('receiptReference') as HTMLInputElement).value;
    document.getElementById('rpTransactionId')!.textContent = txnId || (method === 'cash' ? 'Cash' : '—');

    const body = document.getElementById('rpParticularsBody')!;
    const rows = particulars.length ? particulars : [{ particular: '', amount: 0 }];
    body.innerHTML = rows.map((p, i) => `
      <tr>
        <td>${i + 1}</td>
        <td>${p.particular || ''}</td>
        <td>${p.amount ? formatCurrency(p.amount).replace('₹', '') : ''}</td>
      </tr>
    `).join('');
    document.getElementById('rpTotal')!.textContent = formatCurrency(total).replace('₹', '');
    document.getElementById('rpWords')!.textContent = total > 0 ? amountToWords(total) : '—';
  }

  ['receiptDate', 'receiptAcademicYear', 'receiptFinancialYear', 'receiptReference', 'receiptChequeNumber'].forEach((id) => {
    document.getElementById(id)!.addEventListener('input', updateReceiptPreview);
  });
  document.getElementById('receiptPaymentMethod')!.addEventListener('change', updateReceiptPreview);

  document.getElementById('receiptStudentInput')!.addEventListener('input', (e) => {
    const value = (e.target as HTMLInputElement).value;
    const match = studentOptionMap.get(value);
    if (!match) return;

    selectedReceiptStudent = match;
    const courseDisplay = document.getElementById('receiptCourseDisplay') as HTMLInputElement;
    courseDisplay.value = match.program || 'No program assigned — use "Assign Program" in Student Management first';

    updateReceiptPreview();
  });

  document.getElementById('openGenerateReceiptBtn')!.addEventListener('click', () => {
    resetGenerateReceiptForm();
    populateStudentDatalist();
    document.getElementById('generateReceiptTitle')!.textContent = 'Generate Fee Receipt';
    (document.getElementById('generateReceiptFormWrap') as HTMLElement).hidden = false;
    document.getElementById('receiptSuccessPanel')!.hidden = true;
    updateReceiptPreview();
    openModal('generateReceiptModal');
  });

  document.getElementById('generateReceiptForm')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('generateReceiptBtn') as HTMLButtonElement;
    const alertBox = document.getElementById('receipt-alert')!;
    alertBox.style.display = 'none';

    if (!selectedReceiptStudent) {
      alertBox.className = 'alert alert-error';
      alertBox.textContent = 'Select a student from the search list first.';
      alertBox.style.display = 'block';
      return;
    }
    if (!selectedReceiptStudent.enrollment_id) {
      alertBox.className = 'alert alert-error';
      alertBox.textContent = 'This student has no program enrollment yet. Use "Assign Program" in Student Management first.';
      alertBox.style.display = 'block';
      return;
    }

    const particulars = getFeeParticulars();
    const total = particulars.reduce((sum, p) => sum + p.amount, 0);
    if (total <= 0) {
      alertBox.className = 'alert alert-error';
      alertBox.textContent = 'Add at least one fee particular with an amount greater than zero.';
      alertBox.style.display = 'block';
      return;
    }

    const method = (document.getElementById('receiptPaymentMethod') as HTMLSelectElement).value;
    let referenceNumber: string | null = null, chequeBank: string | null = null, chequeDate: string | null = null;
    if (['upi', 'netbanking', 'bank_transfer'].includes(method)) {
      referenceNumber = (document.getElementById('receiptReference') as HTMLInputElement).value.trim();
      if (!referenceNumber) {
        alertBox.className = 'alert alert-error';
        alertBox.textContent = 'A transaction/reference number is required for this payment method.';
        alertBox.style.display = 'block';
        return;
      }
    }
    if (method === 'cheque') {
      referenceNumber = (document.getElementById('receiptChequeNumber') as HTMLInputElement).value.trim();
      chequeBank = (document.getElementById('receiptChequeBank') as HTMLInputElement).value.trim();
      chequeDate = (document.getElementById('receiptChequeDate') as HTMLInputElement).value;
      if (!referenceNumber || !chequeBank || !chequeDate) {
        alertBox.className = 'alert alert-error';
        alertBox.textContent = 'Cheque number, bank name and cheque date are all required.';
        alertBox.style.display = 'block';
        return;
      }
    }

    btn.disabled = true;
    btn.textContent = 'Generating...';

    const { data: payment, error } = await supabase.rpc('record_payment', {
      p_enrollment_id: selectedReceiptStudent.enrollment_id,
      p_amount: total,
      p_payment_date: (document.getElementById('receiptDate') as HTMLInputElement).value,
      p_payment_method: method,
      p_reference_number: referenceNumber,
      p_cheque_bank_name: chequeBank,
      p_cheque_date: chequeDate || null,
      p_internal_note: null,
      p_academic_year: (document.getElementById('receiptAcademicYear') as HTMLInputElement).value.trim() || null,
      p_financial_year: (document.getElementById('receiptFinancialYear') as HTMLInputElement).value.trim() || null,
      p_fee_particulars: particulars,
    });

    btn.disabled = false;
    btn.textContent = 'Generate Receipt';

    if (error || !payment) {
      alertBox.className = 'alert alert-error';
      alertBox.textContent = error ? error.message : 'Failed to generate receipt.';
      alertBox.style.display = 'block';
      return;
    }

    (document.getElementById('generateReceiptFormWrap') as HTMLElement).hidden = true;
    const successPanel = document.getElementById('receiptSuccessPanel')!;
    successPanel.hidden = false;
    document.getElementById('successReceiptNo')!.textContent = (payment as any).receipt_number;
    document.getElementById('successStudentName')!.textContent = selectedReceiptStudent.full_name || '—';
    document.getElementById('successCourse')!.textContent = selectedReceiptStudent.program || '—';
    document.getElementById('successAmount')!.textContent = formatCurrency(total);

    const paymentId = (payment as any).id;
    document.getElementById('successViewBtn')!.onclick = () => viewReceipt(paymentId);
    document.getElementById('successDownloadBtn')!.onclick = () => downloadReceipt(paymentId);
    document.getElementById('successPrintBtn')!.onclick = () => printReceipt(paymentId);
    document.getElementById('successBackBtn')!.onclick = () => closeModal('generateReceiptModal');

    await loadReceipts();
    await loadStudents();
  });

  init();
</script>
