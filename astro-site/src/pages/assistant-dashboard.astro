  function updateMethodFields() {
    const method = (document.getElementById('paymentMethod') as HTMLSelectElement).value;
    document.querySelectorAll<HTMLElement>('.method-fields').forEach((block) => {
      const methods = (block.dataset.method as string).split(',');
      block.classList.toggle('active', methods.includes(method));
    });
  }
  document.getElementById('paymentMethod')!.addEventListener('change', updateMethodFields);

  document.getElementById('recordPaymentForm')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('recordPaymentBtn') as HTMLButtonElement;
    const alertBox = document.getElementById('payment-alert')!;
    const method = (document.getElementById('paymentMethod') as HTMLSelectElement).value;

    let referenceNumber: string | null = null, chequeBank: string | null = null, chequeDate: string | null = null;
    if (['upi', 'netbanking', 'bank_transfer'].includes(method)) {
      referenceNumber = (document.getElementById('paymentReference') as HTMLInputElement).value.trim();
      if (!referenceNumber) {
        alertBox.className = 'alert alert-error';
        alertBox.textContent = 'A transaction/reference number is required for this payment method.';
        alertBox.style.display = 'block';
        return;
      }
    }
    if (method === 'cheque') {
      referenceNumber = (document.getElementById('chequeNumber') as HTMLInputElement).value.trim();
      chequeBank = (document.getElementById('chequeBank') as HTMLInputElement).value.trim();
      chequeDate = (document.getElementById('chequeDate') as HTMLInputElement).value;
      if (!referenceNumber || !chequeBank || !chequeDate) {
        alertBox.className = 'alert alert-error';
        alertBox.textContent = 'Cheque number, bank name and cheque date are all required.';
        alertBox.style.display = 'block';
        return;
      }
    }

    btn.disabled = true;
    btn.textContent = 'Recording...';
    alertBox.style.display = 'none';

    const { error } = await supabase.rpc('record_payment', {
      p_enrollment_id: (document.getElementById('paymentEnrollmentId') as HTMLInputElement).value,
      p_amount: parseFloat((document.getElementById('paymentAmount') as HTMLInputElement).value),
      p_payment_date: (document.getElementById('paymentDate') as HTMLInputElement).value,
      p_payment_method: method,
      p_reference_number: referenceNumber,
      p_cheque_bank_name: chequeBank,
      p_cheque_date: chequeDate || null,
      p_internal_note: (document.getElementById('paymentNote') as HTMLTextAreaElement).value.trim() || null,
    });

    if (error) {
      alertBox.className = 'alert alert-error';
      alertBox.textContent = error.message;
      alertBox.style.display = 'block';
    } else {
      alertBox.className = 'alert alert-success';
      alertBox.textContent = 'Payment recorded and receipt generated.';
      alertBox.style.display = 'block';
      await loadStudents();
      setTimeout(() => closeModal('recordPaymentModal'), 1200);
    }
    btn.disabled = false;
    btn.textContent = 'Record Payment';
  });

