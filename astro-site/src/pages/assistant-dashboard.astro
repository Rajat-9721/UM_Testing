  // ---- Fee Receipts ----
  let receiptsCache: any[] = [];

  function formatDateDisplay(dateStr: string) {
    const d = new Date(dateStr + 'T00:00:00');
    if (Number.isNaN(d.getTime())) return dateStr || '—';
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  // Indian financial year runs April -> March.
  function financialYearFor(dateStr: string) {
    const d = new Date(dateStr + 'T00:00:00');
    if (Number.isNaN(d.getTime())) return '';
    const year = d.getFullYear();
    const startYear = d.getMonth() >= 3 ? year : year - 1;
    return `${startYear}-${String(startYear + 1).slice(-2)}`;
  }

  function renderReceiptsTable(rows: any[]) {
    const body = document.getElementById('receiptsTableBody')!;
    if (!rows.length) {
      body.innerHTML = '<tr><td colspan="7" class="empty-state">No receipts generated yet.</td></tr>';
      return;
