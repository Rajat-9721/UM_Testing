    body.innerHTML = rows.map((r) => `
      <tr>
        <td>${r.receipt_number}</td>
        <td>${formatDateDisplay(r.payment_date)}</td>
        <td>${r.student_name || '—'}</td>
        <td>${r.student_code || '—'}</td>
        <td>${r.program_title || '—'}</td>
        <td>${formatCurrency(r.amount)}</td>
